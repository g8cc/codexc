#!/bin/bash
# dshc — dsh headless 夜间通道 (产品命名入口)
#
# 与 codexc 家族同构: codexc = codex 交互会话, dshc = dsh 无人值守 runner。
# 无参等价 run; 其余子命令原样转发 codexc-headless (init/status/selftest/help)。
# 会话接力持久化在 .codingkeeper/dsh-session-id; 密钥由 keydrop 轮换,
# 认证失败先去 keydrop 刷新 (详见 docs/TOOLS.md)。
#
# Env:
#   CODEXC_HEADLESS_CMD  覆盖 worker 命令 (默认本仓库 codexc-dsh-worker)
#   DSH_DIR              dsh 数据目录 (默认 ~/.dsh)
#   其余 env 同 codexc-headless

set -u

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO="$(dirname "$SELF")"

[ $# -gt 0 ] || set -- run
export CODEXC_HEADLESS_CMD="${CODEXC_HEADLESS_CMD:-$REPO/codexc-dsh-worker}"
export DSH_DIR="${DSH_DIR:-$HOME/.dsh}"
exec "$REPO/codexc-headless" "$@"
