#!/bin/bash
# dshc — dsh 入口 (产品命名, 与 codexc 家族同构)
#
#   dshc run                自动: headless 无人值守 runner (队列/gate/审查/burn)
#   dshc init               项目脚手架
#   dshc status             跨项目总览
#   dshc selftest           单元自测 (selftest-integration 同理)
#   dshc <dsh 参数>          透传给 dsh CLI 本体 (--profile <name> ...)
#
# dsh 本体没有裸交互模式 (必须 --profile 启动), 所以裸 dshc 只打印本说明,
# 绝不自动启动无人值守 runner。
#
# Env:
#   CODEXC_HEADLESS_CMD    覆盖 worker 命令 (默认本仓库 codexc-dsh-worker)
#   DSH_DIR                dsh 数据目录 (默认 ~/.dsh)

set -u

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO="$(dirname "$SELF")"

case "${1:-}" in
    run)
        shift
        export CODEXC_HEADLESS_CMD="${CODEXC_HEADLESS_CMD:-$(printf '%q' "$REPO/codexc-dsh-worker")}"
        export DSH_DIR="${DSH_DIR:-$HOME/.dsh}"
        exec "$REPO/codexc-headless" run "$@" ;;
    init|status|selftest|selftest-integration)
        export CODEXC_HEADLESS_CMD="${CODEXC_HEADLESS_CMD:-$(printf '%q' "$REPO/codexc-dsh-worker")}"
        exec "$REPO/codexc-headless" "$@" ;;
    -h|--help|help|"")
        sed -n '3,11p' "$0" | sed -E 's/^# ?//'
        exit 0 ;;
    *)
        exec "${DSH_BIN:-dsh}" "$@" ;;
esac
