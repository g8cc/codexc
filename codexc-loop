ASSERT_FAILURES=0
assert_eq() {  # desc expected actual
    if [ "$2" = "$3" ]; then
        echo "  ok: $1"
    else
        echo "  FAIL: $1 (expected [$2] got [$3])"
        ASSERT_FAILURES=$((ASSERT_FAILURES + 1))
    fi
}

tmpd() { mktemp -d "${TMPDIR:-/tmp}/codexc-loop-test.XXXXXX"; }

cmd_selftest() {
    local d rc bugs
    echo "== queue parsing =="
    d="$(tmpd)"
    cat > "$d/queue.md" <<'EOF'
intro line
## ready
- [ ] first task
- [ ] second task
## review-needed
- [ ] self generated idea
## done
- [x] old task
EOF
    line="$(queue_next "$d/queue.md")"
    assert_eq "first ready task lineno" "3" "${line%%$TAB*}"
    task="$(python3 -c 'import base64,sys; sys.stdout.write(base64.b64decode(sys.argv[1]).decode())' "${line#*$TAB}")"
    assert_eq "first ready task text" "first task" "$task"

    queue_mark_done "$d/queue.md" "${line#*$TAB}"
    grep -qx -- "- \[x\] first task" "$d/queue.md" && rc=0 || rc=1
    assert_eq "mark done rewrites the line" "0" "$rc"
    line="$(queue_next "$d/queue.md")"
    task="$(python3 -c 'import base64,sys; sys.stdout.write(base64.b64decode(sys.argv[1]).decode())' "${line#*$TAB}")"
    assert_eq "next after marking" "second task" "$task"

    printf '## ready\n(no tasks)\n' > "$d/q2.md"
    assert_eq "empty ready -> nothing" "" "$(queue_next "$d/q2.md")"
    assert_eq "missing file -> nothing" "" "$(queue_next "$d/absent.md")"

    echo "== result marker =="
    d="$(tmpd)"
    printf 'blah blah\nTASK_RESULT: DONE\n' > "$d/m1"
    assert_eq "DONE marker" "DONE" "$(result_marker "$d/m1")"
    printf 'TASK_RESULT:  blocked: 磁盘满\n' > "$d/m2"
    assert_eq "BLOCKED marker (case/space)" "BLOCKED" "$(result_marker "$d/m2")"
    printf 'no marker here\n' > "$d/m3"
    assert_eq "missing marker" "none" "$(result_marker "$d/m3")"
    : > "$d/m4"
    assert_eq "empty file marker" "none" "$(result_marker "$d/m4")"

    echo "== BUGS line parsing =="
    d="$(tmpd)"
    printf 'found:\n- src/x.py:10 off-by-one\nBUGS: 2\n' > "$d/r1"
    bugs="$(grep -oE 'BUGS:[[:space:]]*[0-9]+' "$d/r1" | tail -1 | grep -oE '[0-9]+')"
    assert_eq "two bugs parsed" "2" "$bugs"
    printf '无问题\nBUGS: 0\n' > "$d/r2"
    bugs="$(grep -oE 'BUGS:[[:space:]]*[0-9]+' "$d/r2" | tail -1 | grep -oE '[0-9]+')"
    assert_eq "zero bugs parsed" "0" "$bugs"
    printf 'review text without marker\n' > "$d/r3"
