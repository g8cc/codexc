#!/bin/bash
# codexc-loop — unattended delivery loop on top of a codexc session.
#
# Turns a codexc session into a supervised delivery pipeline. You put tasks
# in a queue file; the loop feeds them into the running codex TUI one at a
# time, and a finished task is only accepted after
#
#   1. the project's gate script (real tests, run by the shell — an LLM
#      claiming "tests pass" is never trusted) and
#   2. CODEXC_REVIEW_PASS consecutive independent reviews reporting zero bugs
#      (fresh `codex exec review` context, so the author never grades itself)
#
# have both passed. Anything else (gate failures, found bugs, blocked tasks,
# exhausted retries) is fed back into the worker or parks the loop and
# notifies you. Self-generated follow-up tasks land in a "review-needed"
# section of the queue and are never executed until you promote them.
#
# Files (per project, all git-diffable):
#   .codingkeeper/queue.md    task queue: ## ready / ## review-needed / ## done
#   .codingkeeper/gate.sh     acceptance gate: exit 0 = pass (optional)
#   .codingkeeper/journal     one line per accepted task
#   .codingkeeper/loop.halt   touch to pause the loop, rm to resume (also set
#                       automatically when the loop parks itself)
#
# Worker contract: every feed asks codex to end its final message with
#   TASK_RESULT: DONE            (or)
#   TASK_RESULT: BLOCKED: <why>
# The marker is read from the rollout's task_complete event.
#
# Known limitations:
#   - don't run /resume inside a loop session mid-task: a resumed rollout can
#     replay an older TASK_RESULT marker and short-circuit the gate/review of
#     the task in flight (finish or park the task first);
#   - the worker must commit per task for reviews to scope to one task's diff;
#   - a reviewer that never prints "BUGS: <n>" parks the loop (safe direction).
#
# Usage:
#   codexc-loop init            scaffold queue.md + gate.sh + AGENTS.md note
#                               (CLAUDE.md when CODEXC_TOOL=claude)
#   codexc-loop run <pane-id>   internal: drive the pane codexc spawned
#   codexc-loop selftest        unit tests (no tmux/codex needed)
#   codexc-loop selftest-integration  end-to-end against scratch worlds
#   codexc-loop selftest-faultinjection  damage the world on purpose, verify
#                                     the system stays safe
#
# Env:
#   CODEXC_LOOP_POLL      driver poll seconds          (default 5, 1-60)
#   CODEXC_GATE_TIMEOUT   gate.sh hard timeout seconds (default 900)
#   CODEXC_GATE_RETRIES   max gate-failure fix rounds  (default 3)
#   CODEXC_LOOP_STALL     park when the fed task shows no rollout progress
#                         for this many seconds (default 300; catches stuck
#                         modals like the trust/login gates)
#   CODEXC_REVIEW_ROUNDS  max total review runs/task   (default 6)
#   CODEXC_REVIEW_PASS    consecutive zero-bug reviews (default 2)
#   CODEXC_LOOP_DRY       1 = log the first task it would feed, then exit
#                         (never sends keys; default 0)
#   CODEXC_REVIEW_TIMEOUT review hard timeout seconds   (default 1800)
#   CODEXC_LOOP_IDLE      burn mode (default ON): when the queue runs dry,
#                         feed a standing improve/harden prompt; "0" disables;
#                         any other text replaces the built-in prompt
#   CODEXC_IDLE_PARK      no-op sweeps of the fuel catalog before the boiler parks
#                         itself and notifies (default 2)
#   CODEXC_REVIEW_CMD     override reviewer command (reads instructions on
#                         stdin; must print BUGS: <n>; default uses a
#                         read-only `codex exec --ephemeral` reviewer that
#                         inspects the uncommitted diff itself)
#   CODEXC_LOOP_ROLLOUT   debug/test: force the worker rollout file path
#                         instead of discovering it via lsof

set -u

CK_LANE=codex-loop
. "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/ck-common.sh" || { echo "codex-loop: cannot source ck-common.sh (put it next to $0)" >&2; exit 1; }


# absolute self path: the integration harness cds into scratch dirs before
# re-invoking this script, so a relative $0 would break there
SELF="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/$(basename "$0")"

CODEXC_TOOL="${CODEXC_TOOL:-codex}"
case "$CODEXC_TOOL" in
    codex|claude|pi|opencode) ;;
    *) echo "codexc-loop: unsupported CODEXC_TOOL '$CODEXC_TOOL' (use codex|claude|pi|opencode)" >&2; exit 1 ;;
esac
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
PI_DIR="${PI_DIR:-$HOME/.pi/agent}"
OPENCODE_DIR="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}"

CODEXC_LOOP_POLL="$(normalize_uint CODEXC_LOOP_POLL "${CODEXC_LOOP_POLL:-5}" 5 1 60)"
CODEXC_GATE_TIMEOUT="$(normalize_uint CODEXC_GATE_TIMEOUT "${CODEXC_GATE_TIMEOUT:-900}" 900 5 86400)"
CODEXC_GATE_RETRIES="$(normalize_uint CODEXC_GATE_RETRIES "${CODEXC_GATE_RETRIES:-3}" 3 0 50)"
CODEXC_REVIEW_ROUNDS="$(normalize_uint CODEXC_REVIEW_ROUNDS "${CODEXC_REVIEW_ROUNDS:-6}" 6 1 100)"
CODEXC_REVIEW_PASS="$(normalize_uint CODEXC_REVIEW_PASS "${CODEXC_REVIEW_PASS:-2}" 2 1 10)"
CODEXC_REVIEW_TIMEOUT="$(normalize_uint CODEXC_REVIEW_TIMEOUT "${CODEXC_REVIEW_TIMEOUT:-1800}" 1800 5 86400)"
CODEXC_LOOP_STALL="$(normalize_uint CODEXC_LOOP_STALL "${CODEXC_LOOP_STALL:-300}" 300 5 86400)"
CODEXC_TURN_TIMEOUT="$(normalize_uint CODEXC_TURN_TIMEOUT "${CODEXC_TURN_TIMEOUT:-3600}" 3600 5 86400)"
# burn mode (default ON): when the queue runs dry, feed a standing
# "keep improving" prompt so the boiler keeps burning on the worker's own
# plan plus a professional hardening checklist. "0/off" restores silent
# waiting; any other value replaces the built-in prompt text.

IDLE_PROMPT_DEFAULT='[codexc-loop] 持续改进: 审查当前代码的正确性/安全/性能/可靠/鲁棒/可维护/测试/依赖/可观测/文档, 发现问题修复并 commit, 无事可做以 TASK_RESULT: DONE (idle) 结尾'
_idle_raw="${CODEXC_LOOP_IDLE-}"
case "$_idle_raw" in
    0|off|no|false) IDLE_PROMPT=""; BURN_ENABLED=0 ;;
    ""|1|on|yes|true) IDLE_PROMPT="$IDLE_PROMPT_DEFAULT" ;;
    *) IDLE_PROMPT="$(printf '%s' "$_idle_raw" | tr '\n' ' ')" ;;
esac
CODEXC_IDLE_PARK="$(normalize_uint CODEXC_IDLE_PARK "${CODEXC_IDLE_PARK:-2}" 2 1 10)"
CODEXC_LOOP_DRY="$(normalize_uint CODEXC_LOOP_DRY "${CODEXC_LOOP_DRY:-0}" 0 0 1)"

# EXIT-trap cleanup must live on GLOBALS: a trap set inside a function that
# references its locals evaluates them after the function returned (out of
# scope), and set -u makes the whole rm fail silently
# ---- pane helpers -----------------------------------------------------------

# tmux 3.6a quirk: display-message exits 0 with empty output even for targets
# that do not exist, so liveness must be judged by the output, not the code
pane_alive() { [ -n "$(tmux display-message -p -t "$1" '#{pane_id}' 2>/dev/null)" ]; }

# Busy markers verified live: codex "esc to interrupt", claude "ctrl+c to
# interrupt", pi "...to interrupt" (all share the substring); opencode's
# footer shows "tok/s" only while a turn streams
pane_busy() {
    case "$CODEXC_TOOL" in
        # opencode's "tok/s" footer persists in the visible transcript after a
        # turn ends; the reliable signal is that the "ctrl+p commands" status
        # hint disappears while a turn streams
        opencode) ! tmux capture-pane -p -t "$1" 2>/dev/null | grep -q "ctrl+p commands" ;;
        *)        tmux capture-pane -p -t "$1" 2>/dev/null | grep -q "to interrupt" ;;
    esac
}
pane_idle() { ! pane_busy "$1"; }

# two-stage send (text, then Enter) — a single burst makes the TUI drop the keypress
feed_msg() {  # $1=pane $2=one-line message
    if [ "$CODEXC_LOOP_DRY" = "1" ]; then
        log "dry: would feed -> $2"
        return 0
    fi
    tmux send-keys -t "$1" -l "$2" || return 1
    sleep 0.4
    tmux send-keys -t "$1" Enter || return 1
}

# ---- worker rollout discovery + turn status ---------------------------------

# The worker's active rollout, identified by its session cwd: codex 0.162+
# holds rollouts in the app-server daemon (outside the pane's process tree),
# so a tree lsof cannot see them. Walk the newest candidates under
# CODEX_HOME/sessions (sessions/YYYY/MM/DD/rollout-*.jsonl) and match
# session_meta.cwd against the pane's working directory — same realpath
# comparison the queue trust uses, so symlinked project paths still match.
# CODEXC_LOOP_ROLLOUT overrides the discovery entirely (tests).
# claude profile: sessions live in $CLAUDE_DIR/projects/<munged>/<uuid>.jsonl
# where the munge maps BOTH "/" and "." to "-" (underscores survive). Same
# scoping rule as codex: only the pane's own project dir, never a global
# newest-file fallback.
claude_project_dir() {
    local p form
    for p in "$1" "$(cd "$1" 2>/dev/null && pwd -P)"; do
        [ -n "$p" ] || continue
        form="$(printf '%s' "$p" | sed 's/[\/.]/-/g')"
        [ -d "$CLAUDE_DIR/projects/$form" ] && { printf '%s' "$form"; return 0; }
    done
    printf '%s' "$(printf '%s' "$1" | sed 's/[\/.]/-/g')"
}

pi_project_dir() {
    local p form
    for p in "$1" "$(cd "$1" 2>/dev/null && pwd -P)"; do
        [ -n "$p" ] || continue
        form="-$(printf '%s' "$p" | sed 's/\//-/g')-"
        [ -d "$PI_DIR/sessions/$form" ] && { printf '%s' "$form"; return 0; }
    done
    printf '%s' "-$(printf '%s' "${1%/}/" | sed 's/\//-/g')-"
}

find_rollout_pi() {  # $1=pane -> newest pi session jsonl for this cwd
    local pane="$1" proj munged newest=""
    proj="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)"
    [ -n "$proj" ] || return 0
    munged="$(pi_project_dir "$proj")"
    [ -n "$munged" ] || return 0
    newest="$(ls -t "$PI_DIR/sessions/$munged"/*.jsonl 2>/dev/null | head -1)"
    [ -n "$newest" ] && printf '%s' "$newest"
}

opencode_active_session() {  # $1=cwd -> newest session id (session_v2)
    python3 - "$1" "$OPENCODE_DIR/opencode.db" <<'PYEOF'
import json, os, sqlite3, sys
cwd, db = sys.argv[1], sys.argv[2]
target = os.path.realpath(cwd)
try:
    conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    rows = conn.execute("SELECT id, directory, time_updated FROM session_v2").fetchall()
except (sqlite3.Error, OSError):
    raise SystemExit(0)
best, best_t = "", -1
for sid, directory, t in rows:
    # realpath on BOTH sides: /tmp vs /private/tmp and symlinked projects
    if directory and os.path.realpath(directory) == target and t > best_t:
        best, best_t = sid, t
sys.stdout.write(best)
PYEOF
}

find_rollout_opencode() {  # $1=pane -> active session id (used as rollout key)
    local pane="$1" proj sid
    proj="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)"
    [ -n "$proj" ] || return 0
    sid="$(opencode_active_session "$proj")"
    [ -n "$sid" ] && printf '%s' "$sid"
}

# Freshness baseline: byte offset for JSONL, message sequence for SQLite.
# No full-file scan, and an empty rollout produces exactly one numeric zero.
terminal_count() {
    if [ "$CODEXC_TOOL" = "opencode" ]; then
        local esc="${1//\'/''}"
        sqlite3 -readonly "$OPENCODE_DIR/opencode.db" "SELECT coalesce(max(seq),0) FROM session_message WHERE session_id='$esc'" 2>/dev/null || printf '0\n'
    else
        stat -f '%z' "$1" 2>/dev/null || printf '0\n'
    fi
}

# rollout "size" feeds the driver's activity/watermark logic; opencode keeps
# everything in sqlite, so its size is the session's message count
rollout_size() {  # $1=rollout path-or-sid
    case "$CODEXC_TOOL" in
        opencode)
            python3 - "$OPENCODE_DIR/opencode.db" "$1" <<'PYEOF'
import hashlib, sqlite3, sys
from pathlib import Path
try:
    with sqlite3.connect(Path(sys.argv[1]).resolve().as_uri() + "?mode=ro", uri=True) as conn:
        row = conn.execute("SELECT seq,data FROM session_message WHERE session_id=? ORDER BY seq DESC LIMIT 1", (sys.argv[2],)).fetchone()
    print(hashlib.sha256(repr(row).encode()).hexdigest())
except (OSError, sqlite3.Error):
    print("0")
PYEOF
            ;;
        *) stat -f '%z' "$1" 2>/dev/null || printf '0\n' ;;
    esac
}

find_rollout_claude() {  # $1=pane -> prints path or nothing
    local pane="$1" proj munged newest=""
    proj="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)"
    [ -n "$proj" ] || return 0
    munged="$(claude_project_dir "$proj")"
    [ -n "$munged" ] || return 0
    newest="$(ls -t "$CLAUDE_DIR/projects/$munged"/*.jsonl 2>/dev/null | head -1)"
    [ -n "$newest" ] && printf '%s' "$newest"
}

find_rollout() {  # $1=pane -> prints path or nothing
    local pane="$1" proj
    if [ -n "${CODEXC_LOOP_ROLLOUT:-}" ]; then
        printf '%s' "$CODEXC_LOOP_ROLLOUT"
        return 0
    fi
    case "$CODEXC_TOOL" in
        claude)   find_rollout_claude "$pane"; return 0 ;;
        pi)       find_rollout_pi "$pane"; return 0 ;;
        opencode) find_rollout_opencode "$pane"; return 0 ;;
    esac
    proj="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null)"
    [ -n "$proj" ] || return 0
    python3 - "$CODEX_HOME_DIR/sessions" "$proj" <<'PYEOF'
import json, os, sys
root, proj = sys.argv[1], os.path.realpath(sys.argv[2])
if not os.path.isdir(root):
    raise SystemExit(0)
cands = []
for current, dirs, files in os.walk(root):
    for name in files:
        if name.endswith(".jsonl"):
            path = os.path.join(current, name)
            try:
                cands.append((os.stat(path).st_mtime, path))
            except OSError:
                continue
cands.sort(reverse=True)
# Match project ownership before deciding which candidate wins. A global
# candidate cap silently blinds older projects when many sessions are active.
for _mtime, path in cands:
    try:
        with open(path, "rb") as fh:
            for _ in range(5):
                line = fh.readline()
                if not line:
                    break
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                payload = d.get("payload") if isinstance(d, dict) else None
                cwd = payload.get("cwd") if isinstance(payload, dict) else None
                if isinstance(cwd, str) and cwd and os.path.realpath(cwd) == proj:
                    sys.stdout.write(path)
                    raise SystemExit(0)
    except OSError:
        continue
PYEOF
}

# Read only a bounded tail and use the actual event byte offset as its token.
# Counting all terminal events each poll was O(total history), and counting
# sidechain/tool-use messages falsely refreshed an older completion.
turn_status_file() {  # $1=tool $2=rollout $3=message output
    python3 - "$1" "$2" "$3" <<'PYEOF'
import json, os, sys
tool, rollout, msg_out = sys.argv[1:]
status, message, token = "none", "", 0
try:
    with open(rollout, "rb") as fh:
        end = fh.seek(0, os.SEEK_END)
        start, chunks, lines = end, [], 0
        while start > 0 and lines < 400 and end - start < 4 * 1024 * 1024:
            size = min(65536, start)
            start -= size
            fh.seek(start)
            chunk = fh.read(size)
            chunks.append(chunk)
            lines += chunk.count(b"\n")
        data = b"".join(reversed(chunks))
        if start:
            boundary = data.find(b"\n") + 1
            start += boundary
            data = data[boundary:]  # discard a potentially partial first record
    records = []
    offset = start
    for line in data.splitlines(keepends=True):
        offset += len(line)
        try:
            item = json.loads(line)
        except (ValueError, UnicodeError):
            continue
        if isinstance(item, dict):
            records.append((item, offset))
    for item, event_end in reversed(records):
        if tool == "codex":
            payload = item.get("payload")
            if not isinstance(payload, dict):
                continue
            kind = payload.get("type")
            if kind in ("turn_aborted", "task_aborted", "error"):
                status = "error"
                break
            if kind in ("task_started", "turn_started", "user_message") or (item.get("type") == "response_item" and payload.get("role") == "user"):
                break
            if kind != "task_complete":
                continue
            status = "error" if payload.get("error") else "clean"
            message = payload.get("last_agent_message")
        elif tool == "claude":
            if item.get("isSidechain"):
                continue
            if item.get("type") == "user":
                break
            if item.get("type") != "assistant":
                continue
            payload = item.get("message")
            if not isinstance(payload, dict):
                break
            if item.get("isApiErrorMessage"):
                status = "error"
                break
            content = payload.get("content")
            if not isinstance(content, list):
                break
            if payload.get("stop_reason") not in ("end_turn", "stop_sequence") or any(isinstance(b, dict) and b.get("type") == "tool_use" for b in content):
                break
            message = "".join(b["text"] for b in content if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str))
            status = "clean"
        else:
            if item.get("type") != "message":
                continue
            payload = item.get("message")
            if not isinstance(payload, dict):
                break
            if payload.get("role") == "user":
                break
            if payload.get("role") != "assistant":
                continue
            reason = payload.get("stopReason")
            if reason in ("error", "aborted", "length"):
                status = "error"
                break
            if reason != "stop":
                break  # toolUse belongs to an unfinished turn
            content = payload.get("content")
            content = content if isinstance(content, list) else []
            message = "".join(b["text"] for b in content if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str))
            status = "clean"
        token = event_end
        break
    if status == "clean":
        with open(msg_out, "w", encoding="utf-8") as out:
            out.write(message if isinstance(message, str) else "")
        with open(msg_out + ".tok", "w") as out:
            out.write(str(token))
except OSError:
    status = "none"
print(status)
PYEOF
}

turn_status_claude() { turn_status_file claude "$@"; }
turn_status_pi() { turn_status_file pi "$@"; }

# opencode profile: rollout is the session's message DIR; the newest assistant
# msg json decides — error{...} means failed turn, time.finish means done;
# the final text lives in storage/part/<sid>/<mid>/*.json text parts
turn_status_opencode() {  # $1=session id $2=msg_out_file
    python3 - "$1" "$OPENCODE_DIR/opencode.db" "$2" <<'PYEOF'
import json, sqlite3, sys
sid, db, msg_out = sys.argv[1], sys.argv[2], sys.argv[3]
status = "none"
try:
    conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    row = conn.execute(
        "SELECT data, seq FROM session_message WHERE session_id=? AND type='assistant' "
        "ORDER BY seq DESC LIMIT 1", (sid,)).fetchone()
    if row:
        d = json.loads(row[0])
        if not isinstance(d, dict):
            print("none")
            raise SystemExit(0)
        if d.get("error") or d.get("finish") == "error":
            status = "error"
        elif d.get("finish") == "stop":
            content = d.get("content")
            content = content if isinstance(content, list) else []
            text = "".join(b["text"] for b in content
                           if isinstance(b, dict) and b.get("type") == "text" and isinstance(b.get("text"), str))
            status = "clean"
            with open(msg_out, "wb") as out:
                out.write(text.encode("utf-8", "replace"))
            with open(msg_out + ".tok", "w") as tok:
                tok.write(str(row[1]))
        # finish=None -> still streaming -> none
except (sqlite3.Error, OSError, json.JSONDecodeError):
    status = "none"
print(status)
PYEOF
}

turn_status() {  # $1=rollout $2=msg_out_file
    case "$CODEXC_TOOL" in
        claude)   turn_status_claude "$@"; return ;;
        pi)       turn_status_pi "$@"; return ;;
        opencode) turn_status_opencode "$@"; return ;;
    esac
    turn_status_file codex "$@"
}

# ---- queue ------------------------------------------------------------------
# Sections: ## ready (auto-fed, top first) / ## review-needed (LLM-generated
# candidates waiting for a human) / ## done. Only "- [ ] <task>" lines count.

# ---- process helpers --------------------------------------------------------

# ---- gate -------------------------------------------------------------------

# ---- review -----------------------------------------------------------------

# ---- driver -----------------------------------------------------------------
# States: idle -> task(work -> gate -> review) -> idle | halt.
# .codingkeeper/loop.halt pauses feeding (auto-created when the loop parks itself).

# one-time state-dir migration (v2.0: .codexc -> .codingkeeper). Runs before
# anything creates the new dir; if a fresh scaffold already exists, the old
# authoritative files (journal/queue/halt/sessions) override it.
# 顶部任务横幅（类 Claude Code 任务面板）: pane-border-status top 常驻一行，
# 随状态机每次变化刷新; # 转义为 ## 防 tmux 格式展开。CODEXC_BANNER=0 关闭。
banner_set() {  # $1=横幅文本
    [ "${CODEXC_BANNER:-1}" = "1" ] || return 0
    local txt="${1//#/##}"
    tmux set-option -p -t "$pane" pane-border-status top 2>/dev/null
    tmux set-option -p -t "$pane" pane-border-format " 🔥 $txt" 2>/dev/null
    local active=0
    case "$1" in 📋*|🔧*|🔍*|🔥*) active=1 ;; esac
    status_write "$1" "${CODEXC_TOOL:-codex}" "$active" "${CK_TURN_TS:-0}"
    return 0
}

# Snapshot BEFORE every feed, including feedback. A worker may finish before
# send-keys returns; taking the baseline afterwards loses that completion.
feed_turn() {
    ck_run_check || return 125
    require_gate_check || return 1
    rollout="$(find_rollout "$pane")"
    feed_path="$rollout"
    feed_size="$(terminal_count "$rollout")"
    last_path="$rollout"
    last_size="$(rollout_size "$rollout")"
    busy_path="$last_path"; busy_size="$last_size"
    feed_started=$(date +%s)
    last_progress_ts=$feed_started
    feed_msg "$pane" "$1"
}

# 状态快照: 桌面面板(menu bar app)的数据源, 每次状态变化即覆盖写
# 项目登记表: 桌面面板发现项目的机制
run_driver() {  # $1=pane
    local pane="$1" rollout msgfile status marker
    local mode="idle" phase="" task="" task_b64="" gate_rounds=0 review_rounds=0
    local zero_streak=0 errored_since=0 empty_logged=0 halted_logged=0
    # watermark of the already-consumed task_complete event: a stale
    # completion must never be re-processed after feeding a fix back
    local done_path="" done_size=0
    # activity tracking: a completion may only be processed once the rollout
    # actually changed since the feed — otherwise a stale tail from the
    # previous task (or a swallowed feed) would be accepted as fresh
    local last_path="" last_size=0 activity=0 last_progress_ts=0
    # burn mode: idle_count = consecutive "nothing to do" completions; at
    # CODEXC_IDLE_PARK the boiler shuts down instead of burning empty turns
    local idle_count=0 task_kind="" head_at_feed=""
    # freshness: a completion is only acceptable if its token (event offset or
    # message seq) is strictly newer than the rollout state at feed time —
    # otherwise a previous task's stale completion could be accepted when a
    # fed turn dies without emitting its own terminal event
    local feed_size=0 feed_path="" feed_started=0 busy_path="" busy_size=0
    # turn_status 结果缓存: rollout 只追加不改写, (路径,大小) 相同则状态必然
    # 相同 — 跳过整文件重扫 (长会话 rollout 可达数十 MB, 此前每个轮询全量读)
    local sts_path="" sts_size=-1 sts_val=""
    local gate_out review_out rc bugs cur_size changed

    mkdir -p ".codingkeeper" 2>/dev/null || return 1
    runner_lock_acquire || return 1
    trap loop_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    migrate_state_dir
    register_project
    review_groups_prepare || return 1
    if ! leaf_recover || ! require_gate_check; then
        touch .codingkeeper/loop.halt
        log "parked: acceptance recovery or required gate failed"
        return 1
    fi
    # sweep temp files left by kill -9'd drivers (the EXIT trap cannot run then)
    rm -f ".codingkeeper"/.loop-msg.* ".codingkeeper"/.loop-gate.* ".codingkeeper"/.loop-review.* 2>/dev/null
    msgfile=".codingkeeper/.loop-msg.$$"
    gate_out=".codingkeeper/.loop-gate.$$"
    review_out=".codingkeeper/.loop-review.$$"
    LOOP_TMP_FILES="$msgfile $msgfile.tok $gate_out $review_out $review_out.instr"
    trap loop_cleanup EXIT

    log "loop driver armed on pane $pane (poll=${CODEXC_LOOP_POLL}s gate_retries=$CODEXC_GATE_RETRIES review_pass=$CODEXC_REVIEW_PASS dry=$CODEXC_LOOP_DRY)"
    notify "无人值守循环已启动 (队列: .codingkeeper/queue.md)"


    while pane_alive "$pane"; do
        sleep "$CODEXC_LOOP_POLL"

        if [ -e ".codingkeeper/loop.halt" ]; then
            if [ "$halted_logged" = "0" ]; then
                banner_set "⛔ 已挂起: rm .codingkeeper/loop.halt 复燃"
                log "halted: .codingkeeper/loop.halt present (rm it to resume)"
                halted_logged=1
            fi
            continue
        fi
        halted_logged=0

        if [ "$mode" = "halt" ]; then
            if [ ! -e ".codingkeeper/loop.halt" ]; then
                CK_TURN_TS=0   # 复燃横幅是 active 态, 不带上一任务的陈旧起点
                banner_set "🔥 复燃: 继续燃烧"
                log "resuming from halt"
                mode="idle"; phase=""
            fi
            continue
        fi

        if [ "$mode" = "task" ] && [ "$phase" = "work" ] && [ "$feed_started" -gt 0 ] && [ $(( $(date +%s) - feed_started )) -ge "$CODEXC_TURN_TIMEOUT" ]; then
            log "parked: worker turn exceeded ${CODEXC_TURN_TIMEOUT}s"
            notify "循环挂起: 回合超过 ${CODEXC_TURN_TIMEOUT}s — $task"
            mode="halt"; phase=""
            touch ".codingkeeper/loop.halt"
            continue
        fi
        if ! pane_idle "$pane"; then
            if [ "$mode" = "task" ]; then
                rollout="$(find_rollout "$pane")"
                cur_size="$(rollout_size "$rollout")"
                if [ "$rollout" != "$busy_path" ] || [ "$cur_size" != "$busy_size" ]; then
                    last_progress_ts=$(date +%s)
                    busy_path="$rollout"; busy_size="$cur_size"
                fi
            fi
            continue
        fi

        if [ "$mode" = "idle" ]; then
            if ! line="$(queue_next ".codingkeeper/queue.md")"; then
                log "parked: queue read failed"
                mode="halt"; touch .codingkeeper/loop.halt
                continue
            fi
            if [ -z "$line" ]; then
                if [ -z "$IDLE_PROMPT" ]; then
                    if [ "$empty_logged" = "0" ]; then
                        log "queue empty (no ready task) — waiting for .codingkeeper/queue.md to grow"
                        empty_logged=1
                    fi
                    continue
                fi
                burn_fuel_check; rc=$?
                if [ "$rc" = 1 ]; then
                    status_write "燃料已扫描完，等待新任务或新 Prompt" "$CODEXC_TOOL" 0 0 waiting_fuel 0
                    continue
                elif [ "$rc" != 0 ]; then
                    log "parked: invalid fuel exhaustion state"
                    mode="halt"; touch .codingkeeper/loop.halt
                    continue
                fi
                [ "$BURN_FUEL_STATE" != renewed ] || idle_count=0
                # burn mode: feed the standing prompt instead of idling
                task_kind="idle"; task="(idle 持续改进)"; task_b64=""
                if ! burn_prompt_prepare; then
                    log "parked: invalid prompt fuel"
                    mode="halt"; touch .codingkeeper/loop.halt
                    continue
                fi
                task="(idle 持续改进: $BURN_PROMPT_ID)"
                if ! leaf_begin ""; then
                    log "parked: leaf baseline failed"
                    mode="halt"; touch .codingkeeper/loop.halt
                    continue
                fi
                if ! feed_turn "$BURN_PROMPT"; then
                    log "failed to feed idle prompt, retrying next poll"
                    continue
                fi
                mode="task"; phase="work"
                gate_rounds=0; review_rounds=0; zero_streak=0; errored_since=0
                done_path=""; done_size=0
                head_at_feed=$(git rev-parse HEAD 2>/dev/null || echo none)
                CK_TURN_TS=$(date +%s)
                banner_set "🔥 空闲燃烧: 持续改进与收尾审查 (队列空)"
            log "idle prompt fed (burn): 持续改进/收尾审查"
                continue
            fi
            empty_logged=0
            task_b64="${line#*$TAB}"
            task="$(python3 -c 'import base64,sys; sys.stdout.write(base64.b64decode(sys.argv[1]).decode("utf-8","replace"))' "$task_b64")"
            task_kind="queue"
            if [ "$CODEXC_LOOP_DRY" = "1" ]; then
                log "dry: would feed task: $task — dry run ends here"
                notify "dry 试跑完成, 未发送任何内容"
                return 0
            fi
            if ! leaf_begin "$task_b64"; then
                log "parked: leaf baseline failed"
                mode="halt"; touch .codingkeeper/loop.halt
                continue
            fi
            if ! feed_turn "[codexc-loop] 队列任务: $task —— 完成后若有代码改动请 git commit, 最后一条消息以 TASK_RESULT: DONE 结尾 (受阻则 TASK_RESULT: BLOCKED: 原因)"; then
                log "failed to feed task, retrying next poll"
                continue
            fi
            mode="task"; phase="work"
            gate_rounds=0; review_rounds=0; zero_streak=0; errored_since=0
            done_path=""; done_size=0
            ready_n="$(python3 "$CK_COMMON_DIR/ck-leaf.py" count .codingkeeper/queue.md 2>/dev/null || true)"
            ready_n="${ready_n:-0}"   # grep -c 无匹配时打 0 但退出 1, 不能再 || echo 0 (会变成两行)
            CK_TURN_TS=$(date +%s)
            banner_set "📋 $task ｜ 队列剩余 ${ready_n} │ 执行中"
            log "task fed: $task"
            continue
        fi

        # Inspect progress before applying the stall timeout: a long turn may
        # have finished while the TUI was busy for more than LOOP_STALL.
        rollout="$(find_rollout "$pane")"
        cur_size=$(rollout_size "$rollout")
        if [ "$rollout" != "$last_path" ] || [ "$cur_size" != "$last_size" ]; then
            activity=1
            last_progress_ts=$(date +%s)
        else
            activity=0
        fi
        if [ $(( $(date +%s) - last_progress_ts )) -ge "$CODEXC_LOOP_STALL" ]; then
            notify "循环挂起: 投喂后 ${CODEXC_LOOP_STALL}s 无进展 — 请检查 TUI ($task)"
            log "parked: no rollout progress for ${CODEXC_LOOP_STALL}s after feed"
            mode="halt"; phase=""
            touch ".codingkeeper/loop.halt"
            continue
        fi
        if [ -z "$rollout" ]; then
            continue
        fi
        if [ -n "$feed_path" ] && [ "$rollout" != "$feed_path" ]; then
            log "parked: rollout changed during task; refusing another session's completion"
            mode="halt"; phase=""
            touch ".codingkeeper/loop.halt"
            continue
        fi
        last_path="$rollout"; last_size="$cur_size"
        if [ "$rollout" = "$sts_path" ] && [ "$cur_size" = "$sts_size" ] && [ -n "$sts_val" ]; then
            status="$sts_val"   # 文件未增长 → 状态不变, 复用上次解析 (msgfile 内容亦未变)
        else
            : > "$msgfile"
            status="$(turn_status "$rollout" "$msgfile")"
            sts_path="$rollout"; sts_size="$cur_size"; sts_val="$status"
        fi
        case "$status" in
            none)
                log "turn outcome not visible yet; waiting"
                continue
                ;;
            error)
                # transient errors are the watcher's job; give it the cooldown
                # window before parking the task. Any rollout growth since the
                # last error means a rescued turn actually RAN (watcher
                # continue -> minutes of work) — restart the grace from this
                # failure instead of parking a functioning rescue cycle.
                if [ "$activity" = "1" ] && [ "$errored_since" != "0" ]; then
                    errored_since=0
                fi
                if [ "$errored_since" = "0" ]; then
                    errored_since=$(date +%s)
                    log "turn ended in error; 60s grace for the watcher before parking"
                elif [ $(( $(date +%s) - errored_since )) -ge 60 ]; then
                    notify "循环挂起: 任务连续报错需要人工处理 ($task)"
                    log "parked: turn keeps ending in error"
                    mode="halt"; phase=""
                    touch ".codingkeeper/loop.halt"
                fi
                continue
                ;;
        esac

        # a clean completion is only processed when the rollout changed since
        # the feed (activity) and was not consumed before (watermark). Review
        # re-runs for the streak need no new events and skip both checks.
        if [ "$status" = "clean" ] && [ "$phase" = "work" ]; then
            if [ "$activity" != "1" ]; then
                continue   # nothing new since the feed; waiting for the turn
            fi
            token="$(cat "$msgfile.tok" 2>/dev/null || echo 0)"
            case "$token" in ''|*[!0-9]*) token=0 ;; esac
            if [ "$token" -le "$feed_size" ]; then
                log "stale completion ignored (token $token <= feed baseline $feed_size)"
                continue
            fi
            done_path="$rollout"; done_size=$cur_size
        fi

        marker="$(result_marker "$msgfile")"
        case "$marker" in
            DONE)
                if [ "$task_kind" = "idle" ]; then
                    changed="$(leaf_changed)" || {
                        log "parked: leaf snapshot failed"
                        mode="halt"; touch .codingkeeper/loop.halt
                        continue
                    }
                    if [ "$changed" = 0 ]; then
                        # genuinely nothing to do: corroborated by the worker's
                        # idle claim AND a clean tree at the same commit
                        idle_count=$((idle_count + 1))
                        if [ "$idle_count" -ge "$BURN_NOOP_LIMIT" ]; then
                            if burn_rotating; then
                                if ! burn_exhaust; then
                                    mode="halt"; touch .codingkeeper/loop.halt
                                    continue
                                fi
                                CK_TURN_TS=0; mode="idle"; phase=""
                                status_write "燃料已扫描完，等待新任务或新 Prompt" "$CODEXC_TOOL" 0 0 waiting_fuel 0
                                notify "工程燃料已扫描完，等待新任务或新 Prompt"
                                continue
                            fi
                            notify "锅炉熄火: 连续 $idle_count 轮无事可做 — 加任务到 queue.md 或 rm .codingkeeper/loop.halt 复燃"
                            log "parked: $idle_count consecutive idle turns — nothing left to burn"
                            mode="halt"; phase=""
                            touch ".codingkeeper/loop.halt"
                            continue
                        fi
                        log "idle turn $idle_count/$BURN_NOOP_LIMIT: nothing to do — burning the standing prompt again"
                        mode="idle"; phase=""
                        continue
                    fi
                    idle_count=0   # real work happened despite/because of the prompt
                    log "idle turn produced real work — gate and review apply"
                fi
                ;;
            BLOCKED)
                notify "循环挂起: codex 报告 BLOCKED — $task"
                log "parked: worker reported BLOCKED for: $task"
                mode="halt"; phase=""
                touch ".codingkeeper/loop.halt"
                continue
                ;;
            *)
                notify "循环挂起: 回合结束但缺少 TASK_RESULT 标记 — $task"
                log "parked: turn ended without TASK_RESULT marker (last message: $(tail -c 120 "$msgfile" | tr '\n' ' '))"
                mode="halt"; phase=""
                touch ".codingkeeper/loop.halt"
                continue
                ;;
        esac

        if [ "$phase" = "work" ]; then
            phase="gate"
            leaf_gate_run "$gate_out"
            rc=$?
            last_progress_ts=$(date +%s)
            [ "$rc" != 125 ] || { phase="work"; continue; }
            if [ "$rc" = 126 ]; then
                log "parked: gate candidate changed or evidence failed"
                mode="halt"; touch .codingkeeper/loop.halt
                continue
            fi
            if [ "$rc" -ne 0 ]; then
                gate_rounds=$((gate_rounds + 1))
                if [ "$gate_rounds" -gt "$CODEXC_GATE_RETRIES" ]; then
                    notify "循环挂起: gate 连续 $gate_rounds 次未通过 — $task"
                    log "parked: gate failed $gate_rounds times (tail: $(gate_tail "$gate_out"))"
                    mode="halt"; phase=""
                    touch ".codingkeeper/loop.halt"
                    continue
                fi
                banner_set "🔧 gate 修复中 (第 $gate_rounds/$CODEXC_GATE_RETRIES 轮) — $task"
                log "gate failed (round $gate_rounds/$CODEXC_GATE_RETRIES) rc=$rc"
                if feed_turn "[codexc-loop] gate 未通过(第 $gate_rounds 次): $(gate_tail "$gate_out") —— 请修复后以 TASK_RESULT: DONE 结尾"; then
                    last_progress_ts=$(date +%s)
                else
                    log "gate feedback deferred (pane busy?) — will retry when the rollout grows"
                fi
                phase="work"
                continue
            fi
            banner_set "🔍 独立审查中 (streak $zero_streak/$CODEXC_REVIEW_PASS) — $task"
            log "gate passed; starting review (streak $zero_streak/$CODEXC_REVIEW_PASS)"
            phase="review"
        fi

        if [ "$phase" = "review" ]; then
            review_rounds=$((review_rounds + 1))
            if [ "$review_rounds" -gt "$CODEXC_REVIEW_ROUNDS" ]; then
                notify "循环挂起: 审查轮次超过 $CODEXC_REVIEW_ROUNDS 上限 — $task"
                log "parked: review rounds exhausted"
                mode="halt"; phase=""
                touch ".codingkeeper/loop.halt"
                continue
            fi
            review_collect "$task" "$review_out"
            bugs="$REVIEW_RESULT"
            last_progress_ts=$(date +%s)
            if [ "$bugs" = "timeout" ]; then
                notify "循环挂起: 审查超时 (${CODEXC_REVIEW_TIMEOUT}s) — $task"
                log "parked: review timed out (tail: $(review_tail "$review_out"))"
                mode="halt"; phase=""
                touch ".codingkeeper/loop.halt"
                continue
            fi
            case "$bugs" in ''|*[!0-9]*) review_valid=0 ;; *) review_valid=1 ;; esac
            if [ "$review_valid" = "0" ]; then
                notify "循环挂起: 审查输出无法解析 (无 BUGS: 行) — $task"
                log "parked: review output unparseable (tail: $(review_tail "$review_out"))"
                mode="halt"; phase=""
                touch ".codingkeeper/loop.halt"
                continue
            fi
            if ! leaf_verify; then
                log "parked: review changed candidate"
                mode="halt"; touch .codingkeeper/loop.halt
                continue
            fi
            if [ "$bugs" -gt 0 ]; then
                zero_streak=0
                log "review round $review_rounds found $bugs bug(s)"
                if feed_turn "[codexc-loop] 独立审查发现 $bugs 个 bug: $(review_tail "$review_out") —— 请修复后以 TASK_RESULT: DONE 结尾"; then
                    last_progress_ts=$(date +%s)
                else
                    log "review feedback deferred (pane busy?) — will retry when the rollout grows"
                fi
                phase="work"
                continue
            fi
            zero_streak=$((zero_streak + 1))
            log "review round $review_rounds: 0 bugs (streak $zero_streak/$CODEXC_REVIEW_PASS)"
            if [ "$zero_streak" -ge "$CODEXC_REVIEW_PASS" ]; then
                token="$(cat "$msgfile.tok" 2>/dev/null || echo 0)"
                case "$token" in ''|*[!0-9]*) token=0 ;; esac
                if [ "$token" -le "$feed_size" ]; then
                    log "stale completion ignored (token $token <= feed baseline $feed_size) — waiting for the fed turn's own event"
                    zero_streak=0
                    phase="work"   # re-run the gate when the real completion lands
                    continue
                fi
                if ! leaf_accept "$task_b64" "accepted after $review_rounds review round(s), gate retries $gate_rounds"; then
                    notify "验收事务无法提交，任务保留待处理"
                    log "parked: acceptance transaction failed"
                    mode="halt"; phase=""
                    touch .codingkeeper/loop.halt
                    continue
                fi
                notify "任务通过验收: $task"
                banner_set "✅ 已验收: $task ｜ 燃烧继续"
            log "task accepted: $task (queue line: ${marked:-not-found})"
                mode="idle"; phase=""; idle_count=0
                rm -f .codingkeeper/burn-exhausted.json
                CK_TURN_TS=0   # 验收完成, 时长归零 (下一个投喂重新起算)
            fi
            # streak < PASS -> loop runs the next review on the following poll
        fi
    done
    log "pane $pane gone, loop driver exiting"
}

