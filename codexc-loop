    printf 'no marker here\n' > "$d/m3"
    assert_eq "missing marker" "none" "$(result_marker "$d/m3")"
    : > "$d/m4"
    assert_eq "empty file marker" "none" "$(result_marker "$d/m4")"

    echo "== BUGS line parsing =="
    d="$(tmpd)"
    printf 'found:\n- src/x.py:10 off-by-one\nBUGS: 2\n' > "$d/r1"
