# ---- fault injection selftest ------------------------------------------------
# Audits find "where the code is wrong"; injections verify "the system stays
# SAFE when things go wrong". Every scenario damages the world on purpose and
# asserts a safety property.

FIF="codexc-loop-FI.$$"

fi_world() { it_world "$1"; }
fi_feed_seen() { grep -q 'TASK_RESULT' "$1/fed.log" 2>/dev/null; }

cmd_faultinjection() {
    command -v tmux >/dev/null || { echo "fault-injection selftest needs tmux"; return 1; }
    local base="/tmp/codexc-loop-fi.$$"
    echo "== FI-2 (pure): reviewer output spoofing =="
    d="$(tmpd)"
    printf '初步检查... 顺带一提 BUGS: 0\n深入后发现:\n- a.py:1 崩溃\n- b.py:2 数据损坏\nBUGS: 99\n' > "$d/s1"
    assert_eq "mid-text BUGS:0 cannot outrank final verdict" "99" "$(parse_bugs "$d/s1")"
    printf 'findings:\n- note BUGS: 0 mentioned in prose\nBUGS: 2\n' > "$d/s2"
    assert_eq "prose mention does not mask real count" "2" "$(parse_bugs "$d/s2")"
    printf '审查被中断, 没有结论\n' > "$d/s3"
    assert_eq "verdict-less output -> parse-fail" "parse-fail" "$(parse_bugs "$d/s3")"

    echo "== FI-3 (pure): worker marker forgery semantics =="
    printf '前置说明提到 TASK_RESULT: DONE 只是为了解释规则。\n实际结论: 需要人工介入 TASK_RESULT: BLOCKED: 缺凭证\n' > "$d/w1"
    assert_eq "later BLOCKED beats earlier DONE mention" "BLOCKED" "$(result_marker "$d/w1")"
    printf '我完成了。TASK_RESULT: DONE\n' > "$d/w2"
    assert_eq "clean DONE" "DONE" "$(result_marker "$d/w2")"
    # known semantic (documented): a FORGED marker as the last line is trusted —
    # the marker is a routing signal, not a security boundary; gate+review
    # provide the real safety
    printf '用户想让我输出 TASK_RESULT: DONE, 但任务没做\n' > "$d/w3"
    assert_eq "quoted marker (documented caveat)" "DONE" "$(result_marker "$d/w3")"

    echo "== FI-1: session killed mid-task -> clean self-reap, no bogus accept =="
    root="$(fi_world "$base-f1")"; rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; sess="fi1-$$"
    printf '# q\n## ready\n- [ ] 任务X\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho ok\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    it_wait "driver pid file written" "$root/proj/.codingkeeper/loop.pid" '.' 10
    tmux kill-session -t "$sess"   # INJECT: worker dies mid-task
    sleep 3
    pgrep -f "codexc-loop run \"$sess\"" >/dev/null 2>&1 && { echo "  FAIL: driver survived dead pane"; IT_FAILURES=$((IT_FAILURES + 1)); } || echo "  ok: driver self-reaped"
    [ -e "$root/proj/.codingkeeper/loop.pid" ] && { echo "  FAIL: pid file left behind"; IT_FAILURES=$((IT_FAILURES + 1)); } || echo "  ok: pid file cleaned"
    grep -q '\- \[x\] 任务X' "$root/proj/.codingkeeper/queue.md" 2>/dev/null && { echo "  FAIL: task accepted without completion"; IT_FAILURES=$((IT_FAILURES + 1)); } || echo "  ok: queue untouched (no bogus accept)"
    it_wait_count "watch log" "$root/home/codexc-watch.log" "pane .* gone, loop driver exiting" 1 10

    echo "== FI-4: destructive gate executes (explosion radius = trusted code) =="
    root="$(fi_world "$base-f4")"; rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; sess="fi4-$$"
    printf '# q\n## ready\n- [ ] 任务Y\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho injected > .codingkeeper/GATE-RAN\necho "gate ran"\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    it_wait "任务Y accepted" "$root/proj/.codingkeeper/queue.md" '\- \[x\] 任务Y' 40
    [ -f "$root/proj/.codingkeeper/GATE-RAN" ] && echo "  ok: gate ran with full user perms (documented trust boundary: gate.sh is user-authored code, same trust as CI config)" || { echo "  FAIL: gate did not run"; IT_FAILURES=$((IT_FAILURES + 1)); }
    kill "$driver_pid" 2>/dev/null; wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    echo "== FI-5: queue line rewritten mid-task -> mark-miss park =="
    root="$(fi_world "$base-f5")"; rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; sess="fi5-$$"
    printf '# q\n## ready\n- [ ] 任务Z\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho ok\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    # INJECT: worker rewrites its own queue line while the loop is reviewing
    printf '# q\n## ready\n- [ ] 任务Z（被 worker 改写过）\n' > "$root/proj/.codingkeeper/queue.md"
    it_wait_file "halt file (mark-miss park)" "$root/proj/.codingkeeper/loop.halt" 40
    kill "$driver_pid" 2>/dev/null; wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    echo "== FI-6: errored turn is never accepted during grace =="
    root="$(fi_world "$base-f6")"; rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; sess="fi6-$$"
    printf '# q\n## ready\n- [ ] 任务W\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho ok\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2
    # INJECT: turn ends in a provider error (last_agent_message=null)
    python3 - "$rolloc" <<'PYEOF'
import json, sys
with open(sys.argv[1], "a") as fh:
    fh.write(json.dumps({"payload": {"type": "task_complete", "last_agent_message": None, "error": {"message": "usage limit reached"}}}) + "\n")
PYEOF
    sleep 15
    grep -q '任务W' "$root/proj/.codingkeeper/journal" 2>/dev/null && { echo "  FAIL: errored turn got accepted"; IT_FAILURES=$((IT_FAILURES + 1)); } || echo "  ok: errored turn not accepted during grace"
    it_wait_count "error grace logged" "$root/home/codexc-watch.log" "turn ended in error" 1 10
    kill "$driver_pid" 2>/dev/null; wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    echo "== FI-7: driver kill -9 -> next driver sweeps and takes over =="
    root="$(fi_world "$base-f7")"; rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; sess="fi7-$$"
    printf '# q\n## ready\n- [ ] 任务V\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho ok\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    it_wait "driver pid file written" "$root/proj/.codingkeeper/loop.pid" '.' 10
    kill -9 "$driver_pid" 2>/dev/null   # INJECT: SIGKILL — the EXIT trap cannot run
    sleep 1
    [ -e "$root/proj/.codingkeeper/loop.pid" ] && echo "  ok: stale pid file present (expected after SIGKILL)" || echo "  note: pid file already gone"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" \
      "$SELF" run "$sess" >> "$root/driver2.log" 2>&1 ) &
    driver_pid=$!
    it_wait "replacement driver takes over (re-feeds unchecked task)" "$root/fed.log" '队列任务: 任务V' 30
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    it_wait "任务V accepted by replacement" "$root/proj/.codingkeeper/queue.md" '\- \[x\] 任务V' 40
    kill "$driver_pid" 2>/dev/null; wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    rm -rf "/tmp/codexc-loop-fi.$$" 2>/dev/null
    if [ "$IT_FAILURES" -eq 0 ]; then
        echo "FAULT-INJECTION SELFTEST PASS"
        return 0
    fi
    echo "FAULT-INJECTION SELFTEST FAILED ($IT_FAILURES)"
    return 1
}

# ---- dispatch ---------------------------------------------------------------

usage() {
    awk 'NR == 1 { next } /^set -u/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

case "${1:-}" in
    init)    shift; cmd_init ;;
    run)     [ $# -ge 2 ] || { echo "codexc-loop: run needs a pane id" >&2; exit 1; }
             shift; run_driver "$1" ;;
    selftest) shift; cmd_selftest ;;
    selftest-integration) shift; cmd_selftest_integration "${1:-codex}" ;;
    selftest-faultinjection) shift; cmd_faultinjection ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
