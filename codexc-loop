    printf '无问题\nBUGS: 0\n' > "$d/r2"
    bugs="$(parse_bugs "$d/r2")"
    assert_eq "zero bugs parsed" "0" "$bugs"
    printf 'review text without marker\n' > "$d/r3"
    bugs="$(parse_bugs "$d/r3")"
    case "$bugs" in ''|*[!0-9]*) bugs="parse-fail" ;; esac
    assert_eq "unparseable -> parse-fail" "parse-fail" "$bugs"

    printf 'codex\n无问题\n\nBUGS: 0\nTASK_RESULT: DONE\ntokens used\n64,877\n' > "$d/r4"
    printf '\000' >> "$d/r4"   # codex exec mixes NUL bytes into stdout
    bugs="$(parse_bugs "$d/r4")"
    assert_eq "CLI transcript with stale verdict is rejected" "parse-fail" "$bugs"

    printf '发现:\n- x.py:1 崩溃\nBUGS: 3\n' > "$d/r5"
    bugs="$(parse_bugs "$d/r5")"
    assert_eq "nonzero count parses" "3" "$bugs"

    echo "== rollout turn_status =="
    d="$(tmpd)"
    printf '%s\n%s\n%s\n' \
        '{"payload":{"type":"task_started"}}' \
        '{"payload":{"type":"message","role":"assistant","content":[{"type":"output_text","text":"..." }]}}' \
        '{"payload":{"type":"task_complete","last_agent_message":"完成\nTASK_RESULT: DONE","error":null}}' \
        > "$d/rollout.jsonl"
    status="$(turn_status "$d/rollout.jsonl" "$d/msg1")"
    assert_eq "clean turn status" "clean" "$status"
    tok="$(cat "$d/msg1.tok" 2>/dev/null || echo 0)"
    case "$tok" in ''|*[!0-9]*) tok=0 ;; esac
    [ "$tok" -gt 0 ] && rc=0 || rc=1
    assert_eq "freshness token emitted (codex)" "0" "$rc"
    assert_eq "last_agent_message decoded" "完成
TASK_RESULT: DONE" "$(cat "$d/msg1")"
    assert_eq "marker from rollout msg" "DONE" "$(result_marker "$d/msg1")"

    printf '%s\n%s\n' \
        '{"payload":{"type":"task_started"}}' \
        '{"payload":{"type":"task_complete","last_agent_message":null,"error":{"message":"429"}}}' \
        > "$d/rollout2.jsonl"
    status="$(turn_status "$d/rollout2.jsonl" "$d/msg2")"
    : > "$d/msg2"   # errored turns write no message file
    assert_eq "errored turn status" "error" "$status"
    assert_eq "errored msg empty" "" "$(cat "$d/msg2")"

    printf '%s\n' '{"payload":{"type":"task_started"}}' > "$d/rollout3.jsonl"
    assert_eq "no task_complete yet" "none" "$(turn_status "$d/rollout3.jsonl" "$d/msg3")"

    echo "== trim_watchlog 自裁剪 (5MB 阈值回归锁) =="
    local wt="$d/watch.log"
    for i in $(seq 1 3000); do printf 'x %2000s\n' "$i" >> "$wt"; done
    WATCHLOG="$wt" trim_watchlog; WATCHLOG="$wt" trim_watchlog
    local tln; tln=$(wc -l < "$wt" | xargs)
    assert_eq "trim 裁剪至 2000 行 (幂等)" "2000" "$tln"
    rm -f "$wt"

    echo "== burn env parsing =="
        parse_idle() {
        case "$1" in
            0|off|no|false) IDLE_PROMPT="" ;;
            ""|1|on|yes|true) IDLE_PROMPT="$IDLE_PROMPT_DEFAULT" ;;
            *) IDLE_PROMPT="$(printf '%s' "$1" | tr '\n' ' ')" ;;
        esac
    }
    parse_idle ""; assert_eq "unset -> default ON" "$IDLE_PROMPT_DEFAULT" "$IDLE_PROMPT"
    parse_idle "0"; assert_eq "off -> disabled" "" "$IDLE_PROMPT"
    parse_idle $'自定义\n提示'; assert_eq "custom flattened" "自定义 提示" "$IDLE_PROMPT"

    echo "== gate command detection =="
    d="$(tmpd)"
    mkdir -p "$d/py-uv"; printf '[project]\nname="x"\n' > "$d/py-uv/pyproject.toml"; touch "$d/py-uv/uv.lock"
    cmds="$( cd "$d/py-uv" && detect_test_cmds )"
    assert_eq "uv project" "uv run pytest -q" "$cmds"

    mkdir -p "$d/node-pnpm"; printf '{"scripts":{"test":"vitest"}}\n' > "$d/node-pnpm/package.json"; touch "$d/node-pnpm/pnpm-lock.yaml"
    cmds="$( cd "$d/node-pnpm" && detect_test_cmds )"
    assert_eq "pnpm project" "pnpm test" "$cmds"

    mkdir -p "$d/go"; printf 'module x\n' > "$d/go/go.mod"
    cmds="$( cd "$d/go" && detect_test_cmds )"
    assert_eq "go project" "go test ./..." "$cmds"

    mkdir -p "$d/none"
    cmds="$( cd "$d/none" && detect_test_cmds )"
    assert_eq "no markers -> nothing" "" "$cmds"

    mkdir -p "$d/mono"; printf '[project]\nname="m"\ndependencies=["pytest"]\n' > "$d/mono/pyproject.toml"; printf 'module m\n' > "$d/mono/go.mod"
    cmds="$( cd "$d/mono" && detect_test_cmds )"
    assert_eq "multi-stack -> both" "python3 -m pytest -q
go test ./..." "$cmds"

    echo "== claude turn_status parsing =="
    d="$(tmpd)"
    mk_claude_rollout() {  # $1=file, rest appended as json lines via python
        python3 - "$@" <<'PYGEN'
import json, sys
path = sys.argv[1]
events = sys.argv[2:]
with open(path, "a", encoding="utf-8") as fh:
    for e in events:
        fh.write(json.dumps(json.loads(e), ensure_ascii=False) + "\n")
PYGEN
    }
    : > "$d/c1.jsonl"
    mk_claude_rollout "$d/c1.jsonl" \
        '{"type":"user","message":{"content":"hi"}}' \
        '{"type":"assistant","isSidechain":true,"message":{"stop_reason":"end_turn","content":[{"type":"text","text":"TASK_RESULT: DONE"}]}}' \
        '{"type":"assistant","message":{"stop_reason":"end_turn","content":[{"type":"tool_use","name":"Bash"}]}}' \
        '{"type":"assistant","message":{"stop_reason":"end_turn","content":[{"type":"text","text":"完成\nTASK_RESULT: DONE"}]}}'
    status="$(CODEXC_TOOL=claude turn_status_claude "$d/c1.jsonl" "$d/c1msg")"
    assert_eq "claude clean status" "clean" "$status"
    tok="$(cat "$d/c1msg.tok" 2>/dev/null || echo 0)"
    case "$tok" in ''|*[!0-9]*) tok=0 ;; esac
    [ "$tok" -gt 0 ] && rc=0 || rc=1
    assert_eq "freshness token emitted (claude)" "0" "$rc"
    assert_eq "claude marker extracted (sidechain skipped)" "DONE" "$(result_marker "$d/c1msg")"

    : > "$d/c2.jsonl"
    mk_claude_rollout "$d/c2.jsonl" \
        '{"type":"assistant","isApiErrorMessage":true,"apiErrorStatus":429,"message":{"content":[{"type":"text","text":"API Error: 429"}]}}'
    status="$(CODEXC_TOOL=claude turn_status_claude "$d/c2.jsonl" "$d/c2msg")"
    assert_eq "claude api-error status" "error" "$status"

    : > "$d/c3.jsonl"
    mk_claude_rollout "$d/c3.jsonl" '{"type":"user","message":{"content":"x"}}'
    printf '%s' '{"type":"assistant","message":{"stop_reason":"end_turn","content":[{"type":"text","text":"partial li' >> "$d/c3.jsonl"   # no newline, invalid json
    status="$(CODEXC_TOOL=claude turn_status_claude "$d/c3.jsonl" "$d/c3msg")"
    assert_eq "partial trailing line tolerated" "none" "$status"

    : > "$d/c4.jsonl"
    mk_claude_rollout "$d/c4.jsonl" \
        '{"type":"assistant","message":{"stop_reason":"end_turn","content":[{"type":"text","text":"ok done"}]}}'
    status="$(CODEXC_TOOL=claude turn_status_claude "$d/c4.jsonl" "$d/c4msg")"
    assert_eq "clean without marker still clean" "clean" "$status"
    assert_eq "final message captured" "ok done" "$(cat "$d/c4msg")"

    echo "== claude project dir munging =="
    d="$(tmpd)"
    mkdir -p "$d/proj.test"
    want="$(printf '%s' "$d/proj.test" | sed 's/[\/.]/-/g')"
    mkdir -p "$d/cfg/projects/$want"
    CLAUDE_DIR="$d/cfg" form="$(claude_project_dir "$d/proj.test")"
    assert_eq "dots+slashes munge to dash (existing dir wins)" "$want" "$form"
    form="$(CLAUDE_DIR="$d/cfg" claude_project_dir "/no/such/dir.v2")"
    assert_eq "non-existing falls back to munged logical path" "-no-such-dir-v2" "$form"

    if [ "$ASSERT_FAILURES" -eq 0 ]; then
        echo "SELFTEST PASS"
        return 0
    fi
    echo "SELFTEST FAILED ($ASSERT_FAILURES)"
    return 1
}

# ---- integration selftest ---------------------------------------------------
# Drives the real state machine against scratch worlds: a real tmux pane
# (`cat > fed.log` acts as the worker), a synthetic rollout under a scratch
# CODEX_HOME, a fake gate and a fake reviewer. No API calls.

IT_FAILURES=0
it_assert() {  # desc expected actual
    if [ "$2" = "$3" ]; then
        echo "  ok: $1"
    else
        echo "  FAIL: $1 (expected [$2] got [$3])"
        IT_FAILURES=$((IT_FAILURES + 1))
    fi
}

it_wait() {  # desc file pattern timeout_seconds
    local desc="$1" file="$2" pattern="$3" limit="$4" n=0
    while [ "$n" -lt "$limit" ]; do
        grep -qE -- "$pattern" "$file" 2>/dev/null && { echo "  ok: $desc"; return 0; }
        sleep 1; n=$((n + 1))
    done
    echo "  FAIL: $desc (timeout waiting for [$pattern] in $file)"
    echo "    ---- tail ----"; tail -5 "$file" 2>/dev/null | sed 's/^/    /'
    IT_FAILURES=$((IT_FAILURES + 1))
    return 1
}

it_wait_count() {  # desc file pattern min_occurrences timeout_seconds
    local desc="$1" file="$2" pattern="$3" need="$4" limit="$5" n=0 c=0
    while [ "$n" -lt "$limit" ]; do
        c="$(grep -c -- "$pattern" "$file" 2>/dev/null)"
        [ -z "$c" ] && c=0
        [ "$c" -ge "$need" ] && { echo "  ok: $desc"; return 0; }
        sleep 1; n=$((n + 1))
    done
    echo "  FAIL: $desc (timeout: wanted $need x [$pattern], got $c in $file)"
    IT_FAILURES=$((IT_FAILURES + 1))
    return 1
}

it_wait_file() {  # desc path timeout_seconds — waits for a file to exist (may be empty)
    local desc="$1" path="$2" n=0
    while [ "$n" -lt "$3" ]; do
        [ -e "$path" ] && { echo "  ok: $desc"; return 0; }
        sleep 1; n=$((n + 1))
    done
    echo "  FAIL: $desc (timeout waiting for file $path)"
    IT_FAILURES=$((IT_FAILURES + 1))
    return 1
}

it_world() {  # creates $1/{home,proj}; echoes scratch root
    local root="$1"
    rm -rf "$root"; mkdir -p "$root/home/sessions" "$root/proj/.codingkeeper"
    if [ "${IT_TOOL:-codex}" = "opencode" ]; then
        mkdir -p "$root/home/oc"
        sqlite3 "$root/home/oc/opencode.db" \
          "CREATE TABLE session_v2 (id text PRIMARY KEY, directory text NOT NULL, time_updated integer NOT NULL);
           CREATE TABLE session_message (id text PRIMARY KEY, session_id text NOT NULL, type text NOT NULL, seq integer NOT NULL, time_created integer NOT NULL, time_updated integer NOT NULL, data text NOT NULL);
           INSERT INTO session_v2 VALUES ('ses_scratch', '$root/proj', 1);" >/dev/null
    fi
    printf '%s' "$root"
}

it_fake_review() {  # $1=script path $2..=sequence of bug counts
    local script="$1"; shift
    {
        echo '#!/bin/bash'
        echo 'cat > /dev/null   # consume instructions from stdin'
        echo 'counts=$(cat "'"$script"'.counts" 2>/dev/null || echo '"$*"' )'
        echo 'n=$(echo "$counts" | cut -d" " -f1)'
        echo 'rest=$(echo "$counts" | cut -s -d" " -f2-)'
        echo 'printf "%s" "$rest" > "'"$script"'.counts"'
        echo 'echo "review findings..."; echo "BUGS: $n"'
    } > "$script"
    chmod +x "$script"
    printf '%s\n' "$*" > "$script.counts"
}

it_hanging_fixture() {  # $1=script $2=own PID record $3=gate|review
    {
        printf '#!/bin/bash\n'
        printf 'pidfile=%q\n' "$2"
        [ "$3" != "review" ] || printf 'cat > /dev/null\n'
        cat <<'SHFIXTURE'
sleep 120 &
child=$!
printf '%s\n%s\n' "$$" "$child" > "$pidfile"
wait "$child"
SHFIXTURE
        [ "$3" != "review" ] || printf 'echo "BUGS: 0"\n'
    } > "$1"
    chmod +x "$1"
}

it_assert_fixture_exited() {  # $1=label $2=this scenario's parent/child PID file
    local helper
    helper="$(dirname "$(readlink -f "$SELF" 2>/dev/null || printf '%s' "$SELF")")/tests/fixture_processes.py"
    if python3 "$helper" "$2"; then
        echo "  ok: $1 child tree terminated (own parent + child PIDs)"
    else
        echo "  FAIL: $1 child survived kill_tree or PID evidence missing"
        IT_FAILURES=$((IT_FAILURES + 1))
        return 1
    fi
}

it_append_complete() {  # $1=rollout(path or message-dir) $2=marker-message text
    if [ "${IT_TOOL:-codex}" = "opencode" ]; then
        python3 - "$2" "${OPENCODE_DATA_DIR:?opencode harness needs OPENCODE_DATA_DIR}" <<'PYEOF'
import json, sqlite3, sys
text, oc = sys.argv[1], sys.argv[2]
conn = sqlite3.connect(oc + "/opencode.db")
n = conn.execute("SELECT count(*) FROM session_message").fetchone()[0]
mid = "msg_scratch_%d" % (n + 1)
conn.execute("INSERT INTO session_message VALUES (?,?,?,?,?,?,?)",
             (mid, "ses_scratch", "assistant", n + 1, n + 1, n + 1,
              json.dumps({"finish": "stop",
                          "content": [{"type": "text", "text": text}]})))
conn.commit()
PYEOF
    elif [ "${IT_TOOL:-codex}" = "pi" ]; then
        python3 - "$1" "$2" <<'PYEOF'
import json, sys
event = {"type": "message", "message": {"role": "assistant", "stopReason": "stop",
         "content": [{"type": "text", "text": sys.argv[2]}]}}
with open(sys.argv[1], "a", encoding="utf-8") as fh:
    fh.write(json.dumps(event, ensure_ascii=False) + "\n")
PYEOF
    elif [ "${IT_TOOL:-codex}" = "claude" ]; then
        python3 - "$1" "$2" <<'PYEOF'
import json, sys
events = [
    {"type": "user", "message": {"content": "go"}},
    {"type": "assistant", "message": {"stop_reason": "end_turn",
     "content": [{"type": "text", "text": sys.argv[2]}]}},
]
with open(sys.argv[1], "a", encoding="utf-8") as fh:
    for e in events:
        fh.write(json.dumps(e, ensure_ascii=False) + "\n")
PYEOF
    else
        python3 - "$1" "$2" <<'PYEOF'
import json, sys
event = {"payload": {"type": "task_complete", "last_agent_message": sys.argv[2], "error": None}}
with open(sys.argv[1], "a", encoding="utf-8") as fh:
    fh.write(json.dumps(event) + "\n")
PYEOF
    fi
}

cmd_selftest_integration() {
    IT_TOOL="${1:-codex}"
    case "$IT_TOOL" in codex|claude|pi|opencode) ;; *) echo "unknown tool '$IT_TOOL'"; return 1 ;; esac
    export CODEXC_TOOL="$IT_TOOL"
    echo "(tool under test: $IT_TOOL)"
    command -v tmux >/dev/null || { echo "integration selftest needs tmux"; return 1; }
    local base="/tmp/codexc-loop-it.$$" root sess driver_pid
    echo "== scenario 1: happy path (feed -> gate -> 2x zero reviews -> done) =="
    root="$(it_world "$base-s1")"; if [ "$IT_TOOL" = opencode ]; then rolloc=""; worker_cmd="sh -c 'echo \"ctrl+p commands\"; cat > $root/fed.log'"; export OPENCODE_DATA_DIR="$root/home/oc"; else rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; fi; sess="loopit-s1-$$"
    printf '# q\n## ready\n- [ ] 实现加法函数\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho "gate ok"\nexit 0\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" CODEXC_GATE_TIMEOUT=20 \
      CODEXC_REVIEW_CMD="$root/review.sh" CODEXC_REVIEW_PASS=2 \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed into pane" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2   # let the driver enter task mode
    it_append_complete "$rolloc" "完成\nTASK_RESULT: DONE"
    it_wait "queue marked done" "$root/proj/.codingkeeper/queue.md" '\- \[x\] 实现加法函数' 40
    it_wait "journal written" "$root/proj/.codingkeeper/journal" 'accepted after 2 review' 10
    kill "$driver_pid" 2>/dev/null   # the driver idles by design; stop it explicitly
    wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    echo "== scenario 2: gate fails once, then passes =="
    root="$(it_world "$base-s2")"; if [ "$IT_TOOL" = opencode ]; then rolloc=""; worker_cmd="sh -c 'echo \"ctrl+p commands\"; cat > $root/fed.log'"; export OPENCODE_DATA_DIR="$root/home/oc"; else rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; fi; sess="loopit-s2-$$"
    printf '# q\n## ready\n- [ ] 任务B\n' > "$root/proj/.codingkeeper/queue.md"
    { echo '#!/bin/bash'
      echo 'c=$(cat '"$root"'/gate.counts 2>/dev/null || echo 1)'
      echo 'echo "$((c-1))" > '"$root"'/gate.counts'
      echo 'if [ "$c" -ge 1 ]; then echo "unit test boom"; exit 1; fi'
      echo 'echo "gate ok"; exit 0'
    } > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" CODEXC_REVIEW_PASS=2 \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    it_wait "gate failure fed back" "$root/fed.log" 'gate 未通过' 30
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    it_wait "second attempt passes gate and completes" "$root/proj/.codingkeeper/queue.md" '\- \[x\] 任务B' 60
    kill "$driver_pid" 2>/dev/null   # the driver idles by design; stop it explicitly
    wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    echo "== scenario 3: review finds bugs, fix, then two zero reviews =="
    root="$(it_world "$base-s3")"; if [ "$IT_TOOL" = opencode ]; then rolloc=""; worker_cmd="sh -c 'echo \"ctrl+p commands\"; cat > $root/fed.log'"; export OPENCODE_DATA_DIR="$root/home/oc"; else rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; fi; sess="loopit-s3-$$"
    printf '# q\n## ready\n- [ ] 任务C\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho ok\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 3 0 0
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" CODEXC_REVIEW_PASS=2 \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    it_wait "bugs fed back" "$root/fed.log" '独立审查发现 3 个 bug' 30
    sleep 2
    it_append_complete "$rolloc" "修复完毕 TASK_RESULT: DONE"
    it_wait "task done after fix + double zero" "$root/proj/.codingkeeper/queue.md" '\- \[x\] 任务C' 60
    kill "$driver_pid" 2>/dev/null   # the driver idles by design; stop it explicitly
    wait "$driver_pid" 2>/dev/null
    tmux kill-session -t "$sess" 2>/dev/null

    echo "== scenario 4: review rounds exhausted -> park + halt file =="
    root="$(it_world "$base-s4")"; if [ "$IT_TOOL" = opencode ]; then rolloc=""; worker_cmd="sh -c 'echo \"ctrl+p commands\"; cat > $root/fed.log'"; export OPENCODE_DATA_DIR="$root/home/oc"; else rolloc="$root/home/sessions-w.jsonl"; worker_cmd="cat > $root/fed.log"; fi; sess="loopit-s4-$$"
    printf '# q\n## ready\n- [ ] 任务D\n' > "$root/proj/.codingkeeper/queue.md"
    printf '#!/bin/bash\necho ok\n' > "$root/proj/.codingkeeper/gate.sh"; chmod +x "$root/proj/.codingkeeper/gate.sh"
    it_fake_review "$root/review.sh" 1 1 1 1 1 1 1
    tmux new-session -d -s "$sess" -c "$root/proj" "$worker_cmd"
    ( cd "$root/proj" && CODEX_HOME="$root/home" OPENCODE_DATA_DIR="$root/home/oc" CODEXC_LOOP_POLL=1 CODEXC_LOOP_NOTIFY=0 CODEXC_LOOP_ROLLOUT="$rolloc" \
      CODEXC_REVIEW_CMD="$root/review.sh" CODEXC_REVIEW_ROUNDS=2 \
      "$SELF" run "$sess" >> "$root/driver.log" 2>&1 ) &
    driver_pid=$!
    it_wait "task fed" "$root/fed.log" 'TASK_RESULT' 20
    sleep 2
    # each completion triggers a review that finds a bug and feeds a fix back;
    # after CODEXC_REVIEW_ROUNDS=2 reviews a third cycle must park the loop
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
    it_wait "first bugs fed back" "$root/fed.log" '独立审查发现 1 个 bug' 30
    sleep 2
    it_append_complete "$rolloc" "TASK_RESULT: DONE"
