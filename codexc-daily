#!/bin/bash
# codexc-daily — daily scheduled auto-resume of the last codex task (launchd)
#
# At fire time it does exactly what you would do by hand:
#   1. find the most recent codex session and its working directory
#      (session_meta.cwd of the newest ~/.codex/sessions/**/rollout-*.jsonl)
#   2. if that directory's tmux session is still alive -> wait for an idle
#      TUI, then type continue + Enter
#      if it is gone (cold start) -> open a tmux session in that directory
#      running `codexc resume --last continue` (via codexc, so the 429
#      auto-retry watchdog is armed too)
#   3. skip entirely if the last turn ended cleanly (task_complete in the
#      rollout) — a finished task gets no pointless "continue"
#   4. send a system notification; log to ~/.codex/codexc-daily.log
#
# Usage:
#   codexc-daily                 run one "resume last task" cycle now
#   codexc-daily install 10:00   register daily at 10:00 via launchd (a missed
#                                run while asleep fires once on wake; a
#                                powered-off Mac skips)
#   codexc-daily uninstall       remove the schedule
#   codexc-daily status          registration status + recent runs
#   codexc-daily pause / resume  pause / re-enable (vacations, "not today")
#
# It is a safety net, not an interrupt: if you are using the computer at fire
# time (keyboard/mouse idle < 30 minutes) it skips and notifies; a turn that
# is already running is never interrupted (it waits up to 60s, then skips).
#
# Env: CODEXC_MESSAGE      text sent at fire time (default: continue; baked
#                          into the launchd config at install time)
#     CODEXC_HOME         codex home (default: ~/.codex)
#     CODEXC_DAILY_IDLE   "human at the computer" threshold in minutes
#                         (0-10080; default 30, 0 disables the check)

set -u

# launchd provides a minimal PATH; add the usual install locations
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"

CODEX_HOME_DIR="${CODEX_HOME:-$HOME/.codex}"
CODEXC_MESSAGE="${CODEXC_MESSAGE:-continue}"
CODEXC_EXTRA_RE="${CODEXC_EXTRA_RE:-}"
CODEXC_DAILY_IDLE="${CODEXC_DAILY_IDLE:-30}"
normalize_decimal() {
    local value="$1" leading_zeroes
    leading_zeroes="${value%%[!0]*}"
    value="${value#"$leading_zeroes"}"
    printf '%s' "${value:-0}"
}
case "$CODEXC_DAILY_IDLE" in
    ''|*[!0-9]*) echo "codexc-daily: invalid CODEXC_DAILY_IDLE; using 30 minutes" >&2; CODEXC_DAILY_IDLE=30 ;;
    *)
        CODEXC_DAILY_IDLE="$(normalize_decimal "$CODEXC_DAILY_IDLE")"
        if [ "${#CODEXC_DAILY_IDLE}" -gt 5 ] || [ "$CODEXC_DAILY_IDLE" -gt 10080 ]; then
            echo "codexc-daily: CODEXC_DAILY_IDLE must be between 0 and 10080; using 30 minutes" >&2
            CODEXC_DAILY_IDLE=30
        else
            CODEXC_DAILY_IDLE="$((10#$CODEXC_DAILY_IDLE))"
        fi
        ;;
esac
CODEXC_AUTO_YES="${CODEXC_AUTO_YES:-1}"
case "$CODEXC_AUTO_YES" in
    0|off|no|false) CODEXC_AUTO_YES=0 ;;
    1|2) ;;
    *) echo "codexc-daily: invalid CODEXC_AUTO_YES; disabling auto-yes" >&2; CODEXC_AUTO_YES=0 ;;
esac
PAUSE_FILE="$CODEX_HOME_DIR/codexc-daily.pause"
DAILYLOG="$CODEX_HOME_DIR/codexc-daily.log"
WATCHLOG="$CODEX_HOME_DIR/codexc-watch.log"
LABEL="com.codexc.daily"
PLIST="${CODEXC_DAILY_PLIST:-$HOME/Library/LaunchAgents/$LABEL.plist}"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

log() {
    (umask 077; mkdir -p "$CODEX_HOME_DIR" && touch "$DAILYLOG") 2>/dev/null || return 1
    chmod 600 "$DAILYLOG" || return 1
    echo "$(date '+%F %T') daily: $*" >> "$DAILYLOG"
}

notify() {
    command -v osascript >/dev/null && \
        osascript -e "display notification \"$1\" with title \"codexc-daily\"" 2>/dev/null
}

# System-wide keyboard/mouse idle seconds (video playback doesn't count)
idle_seconds() {
    local ns
    ns="$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print $NF; exit}')"
    case "$ns" in ''|*[!0-9]*) echo 0; return ;; esac
    ns="$(normalize_decimal "$ns")"
    if [ "${#ns}" -gt 18 ]; then
        echo 604801
        return
    fi
    echo $((10#$ns / 1000000000))
}

pause_cmd()  { (umask 077; mkdir -p "$CODEX_HOME_DIR" && touch "$PAUSE_FILE") || return 1; echo "codexc-daily: paused (run 'codexc-daily resume' to re-enable)"; log "paused"; }
resume_cmd() { rm -f "$PAUSE_FILE"; echo "codexc-daily: resumed"; log "resumed"; }

# Path of the most recent codex session rollout (newest *.jsonl by mtime)
latest_rollout() {
    python3 - "$CODEX_HOME_DIR/sessions" <<'PYEOF'
import base64, os, stat, sys

root = sys.argv[1]
newest = None
newest_mtime = -1
for current, dirs, files in os.walk(root, onerror=lambda _error: None):
    for name in files:
        if not name.endswith(".jsonl"):
            continue
        path = os.path.join(current, name)
        try:
            info = os.stat(path, follow_symlinks=False)
        except OSError:
            continue
        if not stat.S_ISREG(info.st_mode):
            continue
        mtime = info.st_mtime_ns
        if mtime > newest_mtime:
            newest, newest_mtime = path, mtime
if newest is not None:
    print(base64.b64encode(os.fsencode(newest)).decode("ascii"))
PYEOF
}

# Working directory of the most recent codex session (session_meta.cwd of the newest rollout)
latest_cwd() {
    local encoded
    if [ "$#" -gt 0 ]; then encoded="$1"; else encoded="$(latest_rollout)"; fi
    [ -n "$encoded" ] || return 0
    python3 - "$encoded" <<'PYEOF'
import base64, json, os, sys
try:
    fh = open(os.fsdecode(base64.b64decode(sys.argv[1])), "rb")
except OSError:
    raise SystemExit(0)
with fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        try:
            payload = json.loads(line).get("payload") or {}
        except Exception:
            continue
        cwd = payload.get("cwd") if isinstance(payload, dict) else None
        if isinstance(cwd, str) and cwd:
            sys.stdout.write(cwd + ".")
            break
PYEOF
}

# How did the newest session's last turn end?
#   complete -> clean finish (task_complete): the task is done or waiting for
#              the user — no reason to nudge it with a pointless "continue"
#   died     -> error / turn_aborted / stream cut mid-turn: rescue candidate
#   died is also the fallback for missing/unparseable rollouts (rescue bias)
last_turn_state() {
    local encoded
    if [ "$#" -gt 0 ]; then encoded="$1"; else encoded="$(latest_rollout)"; fi
    [ -n "$encoded" ] || { echo died; return 0; }
    python3 - "$encoded" <<'PYEOF'
import base64, json, os, sys
BOOKKEEPING = {"token_count", "token_usage_record", "world_state",
               "turn_context", "thread_settings_applied"}
try:
    fh = open(os.fsdecode(base64.b64decode(sys.argv[1])), "rb")
except OSError:
    print("died")
    raise SystemExit
with fh:
    position = fh.seek(0, os.SEEK_END)
    chunks = []
    newline_count = 0
    while position > 0 and newline_count < 201:
        size = min(65536, position)
        position -= size
        fh.seek(position)
        chunk = fh.read(size)
        chunks.append(chunk)
        newline_count += chunk.count(b"\n")
tail = b"".join(reversed(chunks)).decode("utf-8", "replace").splitlines()[-200:]
state = "unknown"
for line in reversed(tail):
    try:
        d = json.loads(line)
    except Exception:
        continue
    payload = d.get("payload") if isinstance(d, dict) else None
    t = (payload.get("type") if isinstance(payload, dict) else None) or (d.get("type") if isinstance(d, dict) else None) or ""
    if not isinstance(t, str):
        continue
    if t in BOOKKEEPING:
        continue
    state = t
    break
print("complete" if state == "task_complete" else "died")
PYEOF
}

sanitize_name() { printf '%s' "$1" | tr -cs 'A-Za-z0-9_-' '-'; }

# Same session-name collision walk as codexc: prepend parent dir names while the name is taken.
# Ownership is compared on PHYSICAL paths so symlinked routes to the same
# directory (e.g. ~/Documents/ai -> .../AIworkspace) count as the same owner.
resolve_session_name() {
    local dir="$1" name cand p spath spath_phys base suffix dir_phys
    dir_phys="$(cd "$dir" 2>/dev/null && pwd -P)" || dir_phys="$dir"
    cand="$(basename "$dir_phys")"
    p="$dir_phys"
    while :; do
        name="$(sanitize_name "$cand")"
        if ! tmux has-session -t "=$name" 2>/dev/null; then
            echo "$name"; return 0
        fi
        spath="$(tmux display-message -t "$name" -p '#{session_path}' 2>/dev/null)"
        spath_phys="$(cd "$spath" 2>/dev/null && pwd -P)"
        if [ "$spath_phys" = "$dir_phys" ]; then
            echo "$name"; return 0
        fi
        if [ "$p" = "/" ]; then
            base="$name"
            suffix=2
            while :; do
                name="$(sanitize_name "$base-$suffix")"
                if ! tmux has-session -t "=$name" 2>/dev/null; then
                    echo "$name"; return 0
                fi
                spath="$(tmux display-message -t "$name" -p '#{session_path}' 2>/dev/null)"
                spath_phys="$(cd "$spath" 2>/dev/null && pwd -P)"
                if [ "$spath_phys" = "$dir_phys" ]; then
                    echo "$name"; return 0
                fi
                suffix=$((suffix + 1))
            done
        fi
        p="$(dirname "$p")"
        cand="$(basename "$p")-$cand"
    done
}

send_text() {  # $1=pane $2=text — two-stage send; a single burst makes the TUI drop Enter
    tmux send-keys -t "$1" -l "$2" || return 1
    sleep 0.4
    tmux send-keys -t "$1" Enter
}

run_now() {
    command -v tmux  >/dev/null || { echo "codexc-daily: tmux is required" >&2; exit 1; }
    command -v python3 >/dev/null || { echo "codexc-daily: python3 is required" >&2; exit 1; }
    local cwd name pane cmd rollout session_path
    if [ -f "$PAUSE_FILE" ]; then
        log "paused, skipping"
        notify "codexc-daily is paused, skipping"
        return 0
    fi
    if [ "$CODEXC_DAILY_IDLE" -gt 0 ]; then
        local idle
        idle="$(idle_seconds)"
        if [ "$idle" -lt $((CODEXC_DAILY_IDLE * 60)) ]; then
            log "user active (idle ${idle}s < ${CODEXC_DAILY_IDLE}min), skipping"
            notify "You seem to be at the computer, skipping this run"
            return 0
        fi
        log "user away (idle ${idle}s >= ${CODEXC_DAILY_IDLE}min), proceeding"
    fi
    rollout="$(latest_rollout)"
    cwd="$(latest_cwd "$rollout")"
    cwd="${cwd%.}"
    if [ -z "$cwd" ]; then
        log "no previous codex session found, skipping"
        notify "No previous codex session found, skipping"
        return 0
    fi
    if [ ! -d "$cwd" ]; then
        log "last working dir no longer exists: $cwd, skipping"
        notify "Previous working dir no longer exists, skipping"
        return 0
    fi
    name="$(resolve_session_name "$cwd")"

    if tmux has-session -t "=$name" 2>/dev/null; then
        # session alive: wait for the running turn to finish (up to 60s) before typing
        session_path="$(tmux display-message -p -t "$name" '#{session_path}' 2>/dev/null)"
        if [ "$(cd "$session_path" 2>/dev/null && pwd -P)" != "$(cd "$cwd" 2>/dev/null && pwd -P)" ]; then
            log "session name '$name' changed ownership before send (expected $cwd, found $session_path), skipping"
            notify "Session changed before resume; skipping"
            return 1
        fi
        pane="$(tmux display-message -p -t "$name" '#{pane_id}')"
        log "session '$name' alive (cwd $cwd) -> will send '$CODEXC_MESSAGE'"
        for _ in $(seq 1 30); do
            tmux capture-pane -p -t "$pane" 2>/dev/null | grep -q "esc to interrupt" || break
            sleep 2
        done
        if tmux capture-pane -p -t "$pane" 2>/dev/null | grep -q "esc to interrupt"; then
            log "turn still active after waiting, not sending"
            notify "Turn still active, not sending"
            return 0
        fi
        if [ "$(last_turn_state "$rollout")" = "complete" ]; then
            log "session '$name' alive but last turn completed cleanly, nothing to rescue"
            notify "Last task already completed, skipping"
            return 0
        fi
        if ! tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
            log "pane disappeared before scheduled send"
            return 0
        fi
        if tmux capture-pane -p -t "$pane" 2>/dev/null | grep -q "esc to interrupt"; then
            log "turn became active before scheduled send, not sending"
            notify "Turn became active, not sending"
            return 0
        fi
        if ! send_text "$pane" "$CODEXC_MESSAGE"; then
            log "failed to send prompt to '$name/$pane'"
            notify "Could not send resume prompt"
            return 1
        fi
        log "sent '$CODEXC_MESSAGE' -> $name/$pane"
        notify "Resumed last task (session ${name})"
        return 0
    fi

    # cold start: open a tmux session in the original dir, resume + fire via codexc
    if [ "$(last_turn_state "$rollout")" = "complete" ]; then
        log "cold start skipped: last turn completed cleanly"
        notify "Last task already completed, skipping"
        return 0
    fi
    command -v codex >/dev/null || { echo "codexc-daily: codex CLI is required" >&2; return 1; }
    local run_env
    run_env="env PATH=$(printf '%q' "$PATH") CODEX_HOME=$(printf '%q' "$CODEX_HOME_DIR") CODEXC_MESSAGE=$(printf '%q' "$CODEXC_MESSAGE") CODEXC_AUTO_YES=$(printf '%q' "$CODEXC_AUTO_YES") CODEXC_EXTRA_RE=$(printf '%q' "$CODEXC_EXTRA_RE")"
    if bin="$(command -v codexc)"; then
        cmd="$run_env $(printf '%q' "$bin") resume --last $(printf '%q' "$CODEXC_MESSAGE")"
    else
        cmd="$run_env codex resume --last $(printf '%q' "$CODEXC_MESSAGE")"
        log "codexc launcher not found, falling back to plain codex"
    fi
    tmux new-session -d -s "$name" -c "$cwd" "$cmd" || {
        log "cold start failed to create session '$name' (cwd $cwd)"
        notify "Could not restore the previous session"
        return 1
    }
    log "cold start: created session '$name' (cwd $cwd): $cmd"
    notify "Restored last session and resumed (session ${name})"
}

plist_time() {
    local h m
    h="$(plutil -extract StartCalendarInterval.Hour raw "$PLIST" 2>/dev/null)"
    m="$(plutil -extract StartCalendarInterval.Minute raw "$PLIST" 2>/dev/null)"
    case "$h:$m" in *[!0-9:]*|:|*:|:*) printf 'unknown'; return ;; esac
    if [ "${#h}" -gt 2 ] || [ "${#m}" -gt 2 ]; then printf 'unknown'; return; fi
    h=$((10#$h)); m=$((10#$m))
    if [ "$h" -gt 23 ] || [ "$m" -gt 59 ]; then printf 'unknown'; return; fi
    printf '%02d:%02d' "$h" "$m"
}

install_schedule() {
    local spec="${1:-10:00}" hour minute uid
    case "$spec" in
        *:*) hour="${spec%%:*}"; minute="${spec#*:}" ;;
        *)   hour="$spec"; minute=0 ;;
    esac
    if [ -z "$hour" ] || [ -z "$minute" ]; then
        echo "codexc-daily: bad time '$spec' (use HH:MM, e.g. 10:00)" >&2
        return 1
    fi
    case "$hour$minute" in *[!0-9]*|"")
        echo "codexc-daily: bad time '$spec' (use HH:MM, e.g. 10:00)" >&2; return 1 ;;
    esac
    hour="$(normalize_decimal "$hour")"
    minute="$(normalize_decimal "$minute")"
    if [ "${#hour}" -gt 2 ] || [ "${#minute}" -gt 2 ]; then
        echo "codexc-daily: bad time '$spec' (use HH:MM, e.g. 10:00)" >&2
        return 1
    fi
    hour=$((10#$hour)); minute=$((10#$minute))
    if [ "$hour" -gt 23 ] || [ "$minute" -gt 59 ]; then
        echo "codexc-daily: bad time '$spec' (use HH:MM, e.g. 10:00)" >&2
        return 1
    fi

    command -v python3 >/dev/null || { echo "codexc-daily: python3 is required" >&2; return 1; }
    (umask 077; mkdir -p "$(dirname "$PLIST")" "$CODEX_HOME_DIR") || return 1
    if ! python3 - "$PLIST" "$SELF" "$PATH" "$CODEX_HOME_DIR" "$CODEXC_MESSAGE" "$CODEXC_EXTRA_RE" "$CODEXC_DAILY_IDLE" "$CODEXC_AUTO_YES" "$DAILYLOG" "$LABEL" "$hour" "$minute" <<'PYEOF'
import os, plistlib, sys, tempfile

dest, script, path, codex_home, message, extra_re, idle, auto_yes, log, label, hour, minute = sys.argv[1:]
data = {
    "Label": label,
    "ProgramArguments": [script, "run"],
    "EnvironmentVariables": {
        "PATH": path,
        "CODEX_HOME": codex_home,
        "CODEXC_MESSAGE": message,
        "CODEXC_EXTRA_RE": extra_re,
        "CODEXC_DAILY_IDLE": idle,
        "CODEXC_AUTO_YES": auto_yes,
    },
    "StartCalendarInterval": {"Hour": int(hour), "Minute": int(minute)},
    "StandardOutPath": log,
    "StandardErrorPath": log,
}
directory = os.path.dirname(dest)
fd, temporary = tempfile.mkstemp(prefix=".codexc-daily.", dir=directory)
try:
    with os.fdopen(fd, "wb") as stream:
        plistlib.dump(data, stream, fmt=plistlib.FMT_XML, sort_keys=False)
    os.chmod(temporary, 0o600)
    os.replace(temporary, dest)
except BaseException:
    try:
        os.unlink(temporary)
    except OSError:
        pass
    raise
PYEOF
    then
        echo "codexc-daily: failed to generate launchd plist" >&2
        return 1
    fi
    plutil -lint "$PLIST" >/dev/null || { echo "codexc-daily: generated plist is invalid" >&2; return 1; }

    uid="$(id -u)"
    # idempotent: unload any previous registration after writing a valid replacement
    launchctl bootout "gui/$uid/$LABEL" >/dev/null 2>&1
    [ -f "$PLIST" ] && launchctl unload "$PLIST" >/dev/null 2>&1

    if ! launchctl bootstrap "gui/$uid" "$PLIST" 2>/dev/null; then
        launchctl load "$PLIST" || { echo "codexc-daily: launchctl load failed" >&2; return 1; }
    fi
    echo "codexc-daily: scheduled daily resume at $(printf '%02d:%02d' "$hour" "$minute")"
    echo "  script: $SELF"
    echo "  log: $DAILYLOG"
    echo "  remove: codexc-daily uninstall"
    log "installed launchd schedule at $(printf '%02d:%02d' "$hour" "$minute") (plist: $PLIST)"
}

uninstall_schedule() {
    local uid; uid="$(id -u)"
    launchctl bootout "gui/$uid/$LABEL" >/dev/null 2>&1
    [ -f "$PLIST" ] && launchctl unload "$PLIST" >/dev/null 2>&1
    rm -f "$PLIST"
    echo "codexc-daily: schedule removed"
    log "uninstalled launchd schedule"
}

status() {
    local uid; uid="$(id -u)"
    if [ -f "$PLIST" ]; then
        echo "Registered: daily resume at $(plist_time)"
    else
        echo "Not registered (run: codexc-daily install 10:00)"
    fi
    if [ -f "$PAUSE_FILE" ]; then
        echo "State: paused (run 'codexc-daily resume' to re-enable)"
    else
        echo "State: normal"
    fi
    echo "Idle threshold: ${CODEXC_DAILY_IDLE} min (skips while you are using the computer)"
    if [ "$(last_turn_state)" = "complete" ]; then
        echo "Last task: completed (daily job has nothing to rescue)"
    else
        echo "Last task: interrupted or unknown (daily job will resume it)"
    fi
    if launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then
        echo "launchd: loaded"
    else
        echo "launchd: not loaded"
    fi
    echo "---- Recent runs ($DAILYLOG):"
    tail -n 5 "$DAILYLOG" 2>/dev/null || echo "(no log yet)"
}

case "${1:-run}" in
    run)       shift; run_now "$@" ;;
    install)   shift; install_schedule "${1:-10:00}" ;;
    uninstall) uninstall_schedule ;;
    status)    status ;;
    pause)     pause_cmd ;;
    resume)    resume_cmd ;;
    -h|--help|help) awk 'NR == 1 { next } /^set -u/ { exit } { sub(/^# ?/, ""); print }' "$0" ;;
    *) echo "codexc-daily: unknown action '$1' (run|install|uninstall|status|pause|resume)" >&2; exit 1 ;;
esac
