#!/bin/bash
# codexc-dsh-worker — headless worker adapter for dsh's CLI.
#
# Reads the task from stdin (headless_turn pipes it), runs one non-interactive
# dsh turn (dsh --profile headless [--session-id SID] -), prints the model's
# final answer to stdout (the TASK_RESULT contract), and keeps the session
# alive across turns: dsh persists sessions under
# $DSH_DIR/sessions/<munged-cwd>/session-*/session.v4.jsonl.zstd; the adapter
# extracts the newest session id (zstd) into $DSH_SESSION_FILE so burn mode's
# "按你说的来" retains worker memory. The munge maps "/" to "-" with a dash
# padding each end ("/tmp/" -> "--tmp--", verified against dsh 0.2.0-rc.2).
#
# Env:
#   DSH_BIN            dsh executable   (default dsh)
#   DSH_DIR            dsh data dir     (default ~/.dsh)
#   DSH_PROFILE        profile          (default headless)
#   DSH_SESSION_FILE   session id store (default .codingkeeper/dsh-session-id)
#
# Note: turn failures (auth etc.) surface as empty/error output — the runner
# parks after CODEXC_TURN_RETRIES consecutive failures and shows the tail.

set -u
DSH_BIN="${DSH_BIN:-dsh}"
DSH_DIR="${DSH_DIR:-$HOME/.dsh}"
DSH_PROFILE="${DSH_PROFILE:-headless}"
DSH_SESSION_FILE="${DSH_SESSION_FILE:-.codingkeeper/dsh-session-id}"

dsh_munge() {  # $1=cwd -> munged sessions dir name (first that exists)
    local p form
    for p in "$1" "$(cd "$1" 2>/dev/null && pwd -P)"; do
        [ -n "$p" ] || continue
        form="-$(printf '%s' "${p%/}/" | sed 's/\//-/g')-"
        [ -d "$DSH_DIR/sessions/$form" ] && { printf '%s' "$form"; return 0; }
    done
    printf '%s' "-$(printf '%s' "${1%/}/" | sed 's/\//-/g')-"
}

dsh_newest_sid() {  # newest session-*/ under the munged dir -> its session id
    local munged newest_dir sid
    munged="$(dsh_munge "$PWD")"
    [ -n "$munged" ] || return 0
    newest_dir="$(ls -td "$DSH_DIR/sessions/$munged"/session-* 2>/dev/null | head -1)"
    [ -n "$newest_dir" ] || return 0
    command -v zstd >/dev/null 2>&1 || return 0
    sid="$(zstd -dc "$newest_dir/session.v4.jsonl.zstd" 2>/dev/null | head -1 | \
        python3 -c '
import json, sys
try:
    d = json.loads(sys.stdin.readline())
    sid = d.get("id", "")
    if sid:
        sys.stdout.write(sid)
except Exception:
    pass
' 2>/dev/null)"
    [ -n "$sid" ] && printf '%s' "$sid"
}

sid=""
if [ -s "$DSH_SESSION_FILE" ]; then
    sid="$(head -1 "$DSH_SESSION_FILE" | tr -d '[:space:]')"
    # defensive: dsh errors on an unknown --session-id — drop stale ids whose
    # session dir no longer exists
    if [ -n "$sid" ]; then
        munged="$(dsh_munge "$PWD")"
        ls -d "$DSH_DIR/sessions/$munged"/*"$sid"* >/dev/null 2>&1 || sid=""
    fi
fi

if [ -n "$sid" ]; then
    "$DSH_BIN" --profile "$DSH_PROFILE" --session-id "$sid" -
else
    "$DSH_BIN" --profile "$DSH_PROFILE" -
fi
rc=$?

new_sid="$(dsh_newest_sid)"
if [ -n "$new_sid" ] && [ "$new_sid" != "$sid" ]; then
    mkdir -p "$(dirname "$DSH_SESSION_FILE")" 2>/dev/null
    printf '%s\n' "$new_sid" > "$DSH_SESSION_FILE" 2>/dev/null
fi
exit "$rc"
