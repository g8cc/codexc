#!/bin/bash
# run-all — CodingKeeper 统一测试入口（CI 门禁）。
# 用法: tests/run-all [stage...]   无参 = 全部阶段；可传阶段名子集。
set -u
self_dir="$(cd "$(dirname "$0")/.." && pwd)"
if [ "${CK_TEST_ISOLATED:-0}" != "1" ]; then
    exec python3 "$self_dir/tests/isolate.py" "$@"
fi
cd "$self_dir"
PATH="$self_dir:$PATH"
FAILED=0
declare -a RESULTS

record_stage() {
    local name="$1" file="$2" rc="$3"
    tail -3 "$file" | sed 's/^/  /'
    if [ "$rc" = "0" ]; then
        RESULTS+=("PASS  $name")
    else
        RESULTS+=("FAIL  $name (exit $rc)")
        FAILED=1
        tail -25 "$file" | sed 's/^/  ! /'
        echo "  full log: $file"
    fi
    echo
}

stage() {
    local name="$1"; shift
    echo "════ [$name] ════"
    local file rc
    file="$CK_TEST_ARTIFACTS/$(printf '%s' "$name" | tr -cs 'A-Za-z0-9' '-').log"
    "$@" > "$file" 2>&1; rc=$?
    record_stage "$name" "$file" "$rc"
}

stage_syntax() {
    echo "════ [syntax] ════"
    local bad=0
    for f in ck codexc codexc-loop codexc-daily codexc-headless codexc-zcode-worker codexc-dsh-worker zcodec dshc burn-watch.sh ck-common.sh ck-watch-tools.sh install.sh sync-prefix2.sh tests/run-all tests/conformance.sh tests/keys.sh; do
        bash -n "$f" 2>/dev/null || { echo "  ✗ $f"; bad=1; }
    done
    python3 -m compileall -q ck-config.py ck-watcher.py ck-window.py ck-leaf.py ck-leaves.py ck-prompts.py ck-review-process.py tests || bad=1
    python3 -m py_compile codexc-review-leaf || bad=1
    # Swift 侧语法检查 (今天两个坏提交都是 swift 编译错误漏过 bash -n 门禁)
    if [ -f desktop/CodingKeeperBar.swift ]; then
        swiftc -typecheck desktop/CodingKeeperBar.swift >/dev/null 2>&1 || { echo "  ✗ desktop/CodingKeeperBar.swift (swift parse)"; bad=1; }
    fi
    [ "$bad" = "0" ] && { echo "  ok: Bash + Python + Swift"; RESULTS+=("PASS  syntax"); } || { RESULTS+=("FAIL  syntax"); FAILED=1; }
    echo
}

stage_unit() { stage "unit (loop)" ./codexc-loop selftest; stage "unit (headless)" ./codexc-headless selftest; }
stage_audit() {
    for suite in startup acceptance loop-daily edges desktop tool-watchers harness window zcode-window watch-window zcode-quota leaf-runtime review-leaf leaves burn-runtime prompts; do
        stage "audit $suite" python3 "tests/$suite-audit.py"
    done
}
stage_integration() {
    # Each tool harness owns its scratch cwd, fake services and uniquely named
    # tmux panes. Their independent scenarios can share the private test server.
    local tool file i rc
    local pids=() labels=() files=()
    echo "════ [integration: four isolated tool worlds in parallel] ════"
    for tool in codex claude pi opencode; do
        file="$CK_TEST_ARTIFACTS/integration-$tool.log"
        ./codexc-loop selftest-integration "$tool" > "$file" 2>&1 &
        pids+=("$!"); labels+=("integration $tool"); files+=("$file")
    done
    for i in 0 1 2 3; do
        wait "${pids[$i]}"; rc=$?
        echo "════ [${labels[$i]}] ════"
        record_stage "${labels[$i]}" "${files[$i]}" "$rc"
    done
    stage "integration headless" ./codexc-headless selftest-integration
}
stage_faultinjection() { stage "faultinjection" ./codexc-loop selftest-faultinjection; }
stage_conformance() { stage "conformance" ./tests/conformance.sh; }
stage_keys() { stage "keys (报告性)" ./tests/keys.sh; }
stage_watchdog() { stage "watchdog 自测" ./burn-watch.sh selftest; }

STAGES="${*:-syntax watchdog unit audit integration faultinjection conformance keys}"
for s in $STAGES; do
    case "$s" in
        syntax) stage_syntax ;;
        watchdog) stage_watchdog ;;
        unit) stage_unit ;;
        audit) stage_audit ;;
        integration) stage_integration ;;
        faultinjection) stage_faultinjection ;;
        conformance) stage_conformance ;;
        keys) stage_keys ;;
        *) echo "unknown stage: $s"; FAILED=1 ;;
    esac
done

echo "════════════════════════"
# ${VAR[@]+"${VAR[@]}"}: set -u 下空数组在 bash 3.2 会报 unbound variable
printf '%s\n' ${RESULTS[@]+"${RESULTS[@]}"}
if [ "$FAILED" = "0" ]; then echo "ALL STAGES PASS"; exit 0; fi
echo "FAILURES PRESENT"; exit 1
