#!/bin/bash
# zcodec — ZCode 入口 (产品命名, 与 codexc 家族同构)
#
#   zcodec                  非自动: 唤起 ZCode 桌面应用 (交互界面本体)
#   zcodec <zcode 参数>      透传给 zcode.cjs (login/version/skills/...)
#   zcodec run              自动: headless 无人值守 runner (队列/gate/审查/burn)
#   zcodec init             项目脚手架
#   zcodec status           跨项目总览
#   zcodec leaves [args]    离线审计叶子队列 (不调用模型)
#   zcodec selftest         单元自测 (selftest-integration 同理)
#
# 仅 run/init/status/selftest* 是 CodingKeeper 保留动词; 裸命令绝不启动
# 无人值守 runner。交互面在桌面应用 (cjs 裸跑解析不了 @zcode/tui)。
#
# Env:
#   ZCODE_CJS              zcode.cjs 路径 (默认桌面应用自带)
#   CODEXC_HEADLESS_CMD    覆盖 worker 命令 (默认本仓库 codexc-zcode-worker)
#   CODEXC_ACTIVE_WINDOW   自动任务可用时段 (默认工作日23:00-09:00，周末全天)
#   CODEXC_ACTIVE_TZ       时段时区 (默认 Asia/Shanghai, UTC+8)

set -u

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO="$(dirname "$SELF")"
ZCODE_CJS="${ZCODE_CJS:-/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs}"

hl() {  # CodingKeeper headless 车道转发 (注入默认 worker)
    export CODEXC_HEADLESS_CMD="${CODEXC_HEADLESS_CMD:-$(printf '%q' "$REPO/codexc-zcode-worker")}"
    exec "$REPO/codexc-headless" "$@"
}

case "${1:-}" in
    run)
        # 工作日白天不下发；周末由共享策略放行。显式空值为人工覆盖。
        export CODEXC_ACTIVE_WINDOW="${CODEXC_ACTIVE_WINDOW-23:00-09:00}"
        export CODEXC_ACTIVE_TZ="${CODEXC_ACTIVE_TZ:-Asia/Shanghai}"
        export CODEXC_LOOP_IDLE="${CODEXC_LOOP_IDLE:-1}"
        export CODEXC_REQUIRE_GATE=1
        shift; hl run "$@" ;;
    leaves)
        shift; exec python3 "$REPO/ck-leaves.py" "$@" ;;
    init|status|selftest|selftest-integration)
        hl "$@" ;;
    -h|--help|help)
        sed -n '3,12p' "$0" | sed -E 's/^# ?//' ;;
    *)
        if [ $# -eq 0 ]; then
            # 非自动入口: 唤起桌面应用 (交互界面本体)
            if open -a ZCode 2>/dev/null; then exit 0; fi
            sed -n '3,12p' "$0" | sed -E 's/^# ?//' >&2
            exit 1
        fi
        [ -f "$ZCODE_CJS" ] || { echo "zcodec: zcode.cjs not found at $ZCODE_CJS (set ZCODE_CJS)" >&2; exit 1; }
        command -v node >/dev/null || { echo "zcodec: node is required (>= 24)" >&2; exit 1; }
        exec node "$ZCODE_CJS" "$@" ;;
esac
