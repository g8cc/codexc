#!/bin/bash
# zcodec — ZCode headless 夜间通道 (产品命名入口)
#
# 与 codexc 家族同构: codexc = codex 交互会话, zcodec = zcode 无人值守 runner。
# 无参等价 run; 其余子命令原样转发 codexc-headless (init/status/selftest/help)。
# 会话接力持久化在 .codingkeeper/zcode-session-id, 队列/门禁首次运行自动生成。
#
# Env:
#   CODEXC_HEADLESS_CMD  覆盖 worker 命令 (默认本仓库 codexc-zcode-worker)
#   其余 env 同 codexc-headless (CODEXC_TURN_RETRIES / CODEXC_LOOP_IDLE / ...)

set -u

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO="$(dirname "$SELF")"

[ $# -gt 0 ] || set -- run
export CODEXC_HEADLESS_CMD="${CODEXC_HEADLESS_CMD:-$REPO/codexc-zcode-worker}"
exec "$REPO/codexc-headless" "$@"
