#!/bin/bash
# codexc — Codex with auto-continue when a turn dies from transient errors
# (429 rate limit / exceeded retry limit / stream disconnects), wrapped in
# per-directory tmux sessions.
#
# How it works:
#   Runs `codex` inside a tmux session. A lightweight watcher polls Codex's
#   internal log store (~/.codex/logs_2.sqlite). Every fatal turn error is
#   logged there as "Turn error: ...". When one matches a transient-error
#   pattern, the watcher types "continue" + Enter into the TUI pane — the
#   same thing you would type by hand.
#
# Usage (keep it simple — usually just `codexc`):
#   codexc                         enter the tmux session for the current
#                                  directory; create it if needed. The
#                                  session name is the directory name, and
#                                  name collisions resolve by walking up the
#                                  parent dirs until the name is unique
#                                  (e.g. api, then a-api, then x-a-api).
#                                  Interactive by default: nothing is fed
#                                  into the TUI. `codexc loop` arms the
#                                  unattended delivery loop (auto-scaffolds
#                                  .codingkeeper/ on first run); CODEXC_LOOP=1
#                                  is the env equivalent.
#   codexc -n <name> [codex args]  explicit session name instead of the
#                                  automatic per-directory one
#   codexc -T claude|pi|opencode   drive that tool instead of codex (same
#                                  loop/gate/review pipeline; reviews stay
#                                  on codex for cross-model independence)
#   codexc -T claude [args]        drive Claude Code instead of codex
#                                  (CODEXC_TOOL=claude env also works; the
#                                  delivery loop, gate and reviews work the
#                                  same — reviews stay on codex for
#                                  cross-model independence)
#   codexc resume --last           any other args are passed through to codex
#   codexc "do the task"           (session name comes from the directory)
#   codexc -t 10:00 "do the task"  scheduled task: codex starts now (idle) and
#                                  the prompt is typed at 10:00. HH:MM that
#                                  already passed today fires tomorrow;
#                                  "+2h"/"+30m"/"+45s"/"+90" (minutes) are
#                                  relative. Works with an existing session
#                                  too (queues the prompt into it).
#   codexc loop [codex args]       arm the unattended delivery loop on this
#                                  session (queue feeding + burn mode)
#   codexc ls                      list all tmux sessions
#   codexc status                  cross-project task/runner overview
#   codexc fuel                    boiler fuel gauge: current provider, cc-switch
#                                  failover queue, today/month spend, recent
#                                  relay errors, loop state (read-only)
#   codexc -h                      show this help
#
# Environment overrides:
#   CODEXC_SESSION         tmux session name (default: auto from $PWD)
#   CODEXC_TOOL            coding tool to drive: codex (default) | claude |
#                          pi | opencode (-T/--tool sets the same thing)
#   CODEXC_MESSAGE         injected prompt text      (default: continue)
#   CODEXC_COOLDOWN        min seconds between sends (0-86400, default: 10)
#   CODEXC_MAX_CONTINUES   max auto-continues (0-10000, default: 30, then notification)
#   CODEXC_POLL            watcher poll interval seconds (1-60, default: 2)
#   CODEXC_NOTIFY          completion/stop notifications (0/1, default: 1)
#   CODEXC_NOTIFY_GAP      global min seconds between ANY popups across all
#                          lanes (shared ~/.codingkeeper/.notify-last; default
#                          3, 0 = off) — 多工具并行防弹窗风暴的总闸
#   CODEXC_NOTIFY_SECS     notify on clean turns this long (0-86400, default:
#                          120 — shorter turns stay silent; 0 = every turn)
#   CODEXC_AT              scheduled-fire spec (same as -t, e.g. "10:00")
#   CODEXC_EXTRA_RE        extra auto-continue regex, OR'd with the built-ins
#   CODEXC_AUTO_YES        auto-approve mode: 1 = full-auto (default: skip all
#                          approval prompts, no sandbox), 2 = skip prompts but
#                          keep the workspace sandbox, 0 = off (codex asks)
#   CODEXC_NIGHT_IDLE      night idle takeover seconds (default 600; 0 disables)
#   CODEXC_NIGHT_WINDOW    takeover window (default 00:00-08:00)
#   CODEXC_NIGHT_TZ        window timezone (default Asia/Singapore)
#
# Notes:
#   - Auto-continue fires on transient errors: 429 storms, dropped streams,
#     5xx/relay hiccups, network failures, ... Extend the list with one
#     grep -E regex per line in ~/.codex/codexc.patterns (# comments ok) or
#     via the CODEXC_EXTRA_RE env var (read at watcher startup).
#   - Usage-limit / subscription-cap errors ("usage limit reached", "upgrade
#     to ...") are NEVER auto-continued — this blocklist wins even over
#     custom patterns. Waiting for the reset is the only fix; schedule the
#     retry instead: codexc -t 10:00 "continue".
#   - codexc launches codex in full-auto mode by default (auto-"yes": no
#     approval popups; the current directory is pre-trusted so the "Do you
#     trust this directory?" gate never blocks unattended runs). Set
#     CODEXC_AUTO_YES=0 to keep codex's normal prompts, or 2 to skip prompts
#     while keeping the workspace sandbox.
#   - The watcher (and the scheduler) never type while a turn is running
#     (they look for "esc to interrupt" in the pane); still, don't leave
#     half-typed text in the composer during unattended runs.
#   - Detach with the tmux prefix + d (prefix is Ctrl+a per ~/.tmux.conf);
#     codex keeps running in the background and `codexc` re-attaches.

set -u

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
SCRIPT_DIR="$(dirname "$(readlink -f "$SELF" 2>/dev/null || printf '%s' "$SELF")")"

CODEXC_SESSION="${CODEXC_SESSION:-}"
CODEXC_MESSAGE="${CODEXC_MESSAGE:-continue}"
# 单行化: CR/LF 会被 send-keys -l 字面打进 composer, TUI 把尾随换行当作
# composer 内换行而非提交 ("continue 已输入但没发送, 光标停在下一行" 的根因,
# launchd plist 里曾固化了带 \n 的消息) — 进程级掐掉这类脏字节
CODEXC_MESSAGE="$(printf '%s' "$CODEXC_MESSAGE" | tr -d '\r\n')"
CODEXC_COOLDOWN="${CODEXC_COOLDOWN:-10}"
CODEXC_MAX_CONTINUES="${CODEXC_MAX_CONTINUES:-30}"
CODEXC_POLL="${CODEXC_POLL:-2}"
CODEXC_AT="${CODEXC_AT:-}"
CODEXC_TARGET="${CODEXC_TARGET:-}"
CODEXC_EXTRA_RE="${CODEXC_EXTRA_RE:-}"
CODEXC_AUTO_YES="${CODEXC_AUTO_YES:-1}"
case "$CODEXC_AUTO_YES" in
    0|off|no|false) CODEXC_AUTO_YES=0 ;;
    1|2) ;;
    *) echo "codexc: invalid CODEXC_AUTO_YES '$CODEXC_AUTO_YES'; disabling auto-yes" >&2; CODEXC_AUTO_YES=0 ;;
esac
CODEXC_PROMPT="${CODEXC_PROMPT:-}"
TAB="$(printf '\t')"
CODEXC_TOOL="${CODEXC_TOOL:-codex}"
case "$CODEXC_TOOL" in
    codex|claude|pi|opencode) ;;
    dsh) echo "codexc: dsh is a headless/web harness (profiles: headless, web) — no TUI to feed; it needs the headless driver lane, not codexc loop" >&2; exit 1 ;;
    *) echo "codexc: unsupported CODEXC_TOOL '$CODEXC_TOOL' (use codex|claude|pi|opencode)" >&2; exit 1 ;;
esac
CODEXC_LOOP="${CODEXC_LOOP:-0}"
case "$CODEXC_LOOP" in
    0|off|no|false) CODEXC_LOOP=0 ;;
    1|on|yes|true) CODEXC_LOOP=1 ;;
    *) echo "codexc: invalid CODEXC_LOOP '$CODEXC_LOOP'; running a bare session (codexc loop to arm)" >&2; CODEXC_LOOP=0 ;;
esac

notify() {  # $1=text — macOS 通知, 带跨进程全局弹窗间隔闸 (CODEXC_NOTIFY_GAP, 默认3s, 0=关)
    [ "${CODEXC_NOTIFY:-1}" = "1" ] || return 0
    local text="$1" gap last now esc
    gap="$(normalize_uint CODEXC_NOTIFY_GAP "${CODEXC_NOTIFY_GAP:-3}" 3 0 86400)"
    if [ "$gap" -gt 0 ]; then
        last="$(cat "$HOME/.codingkeeper/.notify-last" 2>/dev/null || echo 0)"
        case "$last" in ''|*[!0-9]*) last=0 ;; esac
        now="$(date +%s)"
        if [ $((now - last)) -lt "$gap" ]; then
            echo "$(date '+%F %T') codexc: notification suppressed (global gap ${gap}s): ${text:0:60}" >> "$WATCHLOG" 2>/dev/null || true
            return 0
        fi
        mkdir -p "$HOME/.codingkeeper" 2>/dev/null
        printf '%s\n' "$now" > "$HOME/.codingkeeper/.notify-last" 2>/dev/null
    fi
    esc="${text//\\/\\\\}"; esc="${esc//\"/\\\"}"
    command -v osascript >/dev/null && \
        osascript -e "display notification \"$esc\" with title \"codexc\"" 2>/dev/null
    return 0
}

normalize_uint() {
    local name="$1" value="$2" fallback="$3" minimum="$4" maximum="$5" number leading_zeroes
    case "$value" in
        ''|*[!0-9]*) echo "codexc: invalid $name '$value'; using $fallback" >&2; printf '%s' "$fallback"; return ;;
    esac
    leading_zeroes="${value%%[!0]*}"
    value="${value#"$leading_zeroes"}"
    value="${value:-0}"
    if [ "${#value}" -gt "${#maximum}" ]; then
        echo "codexc: $name must be between $minimum and $maximum; using $fallback" >&2
        printf '%s' "$fallback"
        return
    fi
    number=$((10#$value))
    if [ "$number" -lt "$minimum" ] || [ "$number" -gt "$maximum" ]; then
        echo "codexc: $name must be between $minimum and $maximum; using $fallback" >&2
        number=$fallback
    fi
    printf '%s' "$number"
}

has_explicit_auto_mode() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --ask-for-approval|--ask-for-approval=*|--sandbox|--sandbox=*|--dangerously-bypass-approvals-and-sandbox|--full-auto|--yolo|-a|-s|-a?*|-s?*|--dangerously-skip-permissions|--permission-mode|--permission-mode=*|--auto) return 0 ;;
            --) return 1 ;;
        esac
        shift
    done
    return 1
}

CODEXC_COOLDOWN="$(normalize_uint CODEXC_COOLDOWN "$CODEXC_COOLDOWN" 10 0 86400)"
CODEXC_MAX_CONTINUES="$(normalize_uint CODEXC_MAX_CONTINUES "$CODEXC_MAX_CONTINUES" 30 0 10000)"
CODEXC_POLL="$(normalize_uint CODEXC_POLL "$CODEXC_POLL" 2 1 60)"
CODEXC_NOTIFY="$(normalize_uint CODEXC_NOTIFY "${CODEXC_NOTIFY:-1}" 1 0 1)"
CODEXC_NOTIFY_SECS="$(normalize_uint CODEXC_NOTIFY_SECS "${CODEXC_NOTIFY_SECS:-120}" 120 0 86400)"

CODEX_HOME_DIR="${CODEX_HOME:-${CODEXC_HOME:-$HOME/.codex}}"
export CODEX_HOME="$CODEX_HOME_DIR"

# Transient provider/relay errors worth an automatic "continue". Covers the
# 429 quota storms, dropped streams, 5xx server/relay hiccups (Bad Gateway,
# Service Unavailable, "server error", overloaded), client-side network
# failures (fetch failed, socket hang up, connection reset), the relay's
# intermittent "Invalid request parameters, please check the request body
# and try again" (a new-api style upstream hiccup — a genuinely malformed
# body would fail every turn, not intermittently), and the relay's brief
# windows where every request 401s (observed 30s burst on 2026-09-06; key
# itself stayed valid). Extendable via ~/.codex/codexc.patterns or
# CODEXC_EXTRA_RE — see load_extra_patterns().
TRANSIENT_RE='exceeded retry limit|Too Many Requests|stream disconnected before completion|error sending request|connection closed|connection reset|timed out|check the request body|401 Unauthorized|INVALID_API_KEY|server error|Bad Gateway|Service Unavailable|Internal Server Error|overloaded|fetch failed|socket hang up|premature close|network error|ECONNRESET|empty response|Selected model is at capacity'

# Hard caps that must never be auto-continued (checked BEFORE TRANSIENT_RE so
# even a broad custom pattern can't cause pointless retries): quotas and
# subscription caps only clear when the window resets or the plan upgrades.
BLOCK_RE='usage limit|upgrade to|subscription|plan limit'

WATCHLOG="$CODEX_HOME_DIR/codexc-watch.log"

prepare_watch_log() {
    (umask 077; mkdir -p "$CODEX_HOME_DIR" && touch "$WATCHLOG") || return 1
    chmod 600 "$WATCHLOG"
}

# ---- self-heal: config switchers (CC Switch etc.) rewrite config.toml from
# stale stored templates and wipe these retry keys — re-add before launch ----
ensure_retry_config() {
    [ -f "$CODEX_HOME_DIR/config.toml" ] || return 0
    python3 "$SCRIPT_DIR/ck-config.py" codex "$CODEX_HOME_DIR/config.toml" retry
}

ensure_project_trust() {
    [ "$CODEXC_AUTO_YES" != "0" ] || return 0
    python3 "$SCRIPT_DIR/ck-config.py" codex "$CODEX_HOME_DIR/config.toml" trust "$PWD" "$(pwd -P)"
}

# ---- claude tool profile ----------------------------------------------------
# claude 2.1.x facts (verified): sessions live in
# $CLAUDE_DIR/projects/<munged-cwd>/<uuid>.jsonl where munging maps BOTH "/"
# and "." to "-" (underscores survive); assistant events carry
# isApiErrorMessage + apiErrorStatus and only land after claude's own
# 10-retry cycle is exhausted; sidechain (subagent) events share the file
# behind isSidechain:true.

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

claude_project_dir() {  # $1=cwd -> munged project dir name (first that exists)
    local p form
    for p in "$1" "$(cd "$1" 2>/dev/null && pwd -P)"; do
        [ -n "$p" ] || continue
        form="$(printf '%s' "$p" | sed 's/[\/.]/-/g')"
        [ -d "$CLAUDE_DIR/projects/$form" ] && { printf '%s' "$form"; return 0; }
    done
    printf '%s' "$(printf '%s' "$1" | sed 's/[\/.]/-/g')"
}

# claude gates unattended runs on two dialogs: the folder trust dialog
# (projects[path].hasTrustDialogAccepted) and the bypass-permissions warning
# (top-level bypassPermissionsModeAccepted). Seed both, on both path forms,
# or the TUI stalls forever exactly like codex's trust gate did.
seed_claude_trust() {
    [ "$CODEXC_AUTO_YES" != "0" ] || return 0
    python3 "$SCRIPT_DIR/ck-config.py" claude "$CLAUDE_DIR/.claude.json" "$CODEXC_AUTO_YES" "$PWD" "$(pwd -P)"
}

# ---- pi / opencode profiles -------------------------------------------------
# pi 0.84: sessions in ~/.pi/agent/sessions/<munged>/<ts>_<uuid>.jsonl; the
# munge maps "/" to "-" and pads a dash on each end (/tmp/ -> --tmp--).
# Turn ends carry message.stopReason ("stop" = done, "toolUse" = mid-turn).
# opencode 2.0: sessions in ~/.local/share/opencode/storage/session/global/
# ses_*.json (directory field), messages in storage/message/<sid>/msg_*.json
# (role, error{data.statusCode}, time.finish), text parts in storage/part/.
PI_DIR="${PI_DIR:-$HOME/.pi/agent}"
OPENCODE_DIR="${OPENCODE_DATA_DIR:-$HOME/.local/share/opencode}"

pi_project_dir() {  # $1=cwd -> munged sessions dir (first that exists)
    local p form
    for p in "$1" "$(cd "$1" 2>/dev/null && pwd -P)"; do
        [ -n "$p" ] || continue
        form="-$(printf '%s' "$p" | sed 's/\//-/g')-"
        [ -d "$PI_DIR/sessions/$form" ] && { printf '%s' "$form"; return 0; }
    done
    printf '%s' "-$(printf '%s' "${1%/}/" | sed 's/\//-/g')-"
}

# ---- session-name resolution ------------------------------------------------
# tmux session names may not contain ':' or '.'; replace anything exotic with
# '-' so paths survive as session names.
sanitize_name() {
    local name
    name="$(printf '%s' "$1" | tr -cs 'A-Za-z0-9_-' '-')"
    # non-ASCII directory names (CJK etc.) collapse to "-" — every such
    # directory would share one session name; append a content hash so each
    # stays unique. ASCII names are untouched (existing sessions keep working)
    case "$(printf '%s' "$name" | tr -d '-')" in
        '') name="-$(printf '%s' "$1" | md5 -q | cut -c1-8)" ;;
    esac
    printf '%s' "$name"
}

# Pick a stable session name for the current directory:
#   1. start with the directory basename (api);
#   2. if that name is taken by ANOTHER directory, prepend parent dir names
#      one level at a time until the name is free (a-api, x-a-api, ...).
# The absolute path is unique, so this loop always terminates.
# Ownership is compared on PHYSICAL paths (pwd -P): the same directory
# reached through a symlink (e.g. ~/Documents/ai -> .../AIworkspace) counts
# as the same owner, not a name collision.
session_tool_matches() {
    local tool command
    tool="$(tmux show-option -p -v -t "=$1:" @codexc_tool 2>/dev/null || true)"
    [ "$tool" = "$CODEXC_TOOL" ] && return 0
    [ -z "$tool" ] || return 1
    command="$(tmux display-message -p -t "=$1:" '#{pane_current_command}' 2>/dev/null)"
    [ "$command" = "$CODEXC_TOOL" ]
}

resolve_session_name() {
    local name cand p spath spath_phys base suffix cwd_phys
    cwd_phys="$(pwd -P)"
    cand="$(basename "$cwd_phys")"
    p="$cwd_phys"
    while :; do
        name="$(sanitize_name "$cand")"
        if ! tmux has-session -t "=$name" 2>/dev/null; then
            echo "$name"; return 0
        fi
        # taken — is it ours (same startup directory, symlinks resolved)?
        spath="$(tmux display-message -t "=$name:" -p '#{session_path}' 2>/dev/null)"
        spath_phys="$(cd "$spath" 2>/dev/null && pwd -P)"
        if [ "$spath_phys" = "$cwd_phys" ] && session_tool_matches "$name"; then
            echo "$name"; return 0
        fi
        # taken by another directory: widen the scope with the parent name
        if [ "$p" = "/" ]; then
            base="$name"
            suffix=2
            while :; do
                name="$(sanitize_name "$base-$suffix")"
                if ! tmux has-session -t "=$name" 2>/dev/null; then
                    echo "$name"; return 0
                fi
                spath="$(tmux display-message -t "=$name:" -p '#{session_path}' 2>/dev/null)"
                spath_phys="$(cd "$spath" 2>/dev/null && pwd -P)"
                if [ "$spath_phys" = "$cwd_phys" ] && session_tool_matches "$name"; then
                    echo "$name"; return 0
                fi
                suffix=$((suffix + 1))
            done
        fi
        p="$(dirname "$p")"
        cand="$(basename "$p")-$cand"
    done
}

usage() {
    # whole header comment: everything from line 2 up to "# Notes:"
    awk 'NR == 1 { next } /^# Notes:/ { exit } { sub(/^# ?/, ""); print }' "$0"
}

# ---- user-extensible auto-continue patterns --------------------------------
# ~/.codex/codexc.patterns: one grep -E regex per line, '#' starts a comment;
# CODEXC_EXTRA_RE adds one more inline. All OR'd with the built-in list.
# Read once at watcher startup — restart the session to pick up edits.
load_extra_patterns() {
    local f="$CODEX_HOME_DIR/codexc.patterns" out=""
    if [ -f "$f" ]; then
        out="$(sed -e 's/[[:space:]]*$//' "$f" | grep -vE '^[[:space:]]*(#|$)' | paste -sd '|' -)"
    fi
    [ -n "$CODEXC_EXTRA_RE" ] && out="${out:+$out|}$CODEXC_EXTRA_RE"
    printf '%s' "$out"
}

# ---- scheduler: type a prompt into a pane at a given time ------------------
# $1 = absolute fire-time epoch, $2 = pane id, $3 = prompt, $4 = display spec.
# Sleeps until the target (gives up if the pane disappears),
# waits for an idle TUI, then sends prompt + Enter (same two-stage send as
# the watcher — a single burst makes the TUI drop the Enter keypress).
parse_schedule_epoch() {
    python3 - "$1" <<'PYEOF'
import sys, datetime
spec = sys.argv[1].strip()
now = datetime.datetime.now().astimezone()
try:
    if spec.startswith("+"):
        s = spec[1:].lower()
        if s.endswith("h"):   delta = datetime.timedelta(hours=float(s[:-1]))
        elif s.endswith("m"): delta = datetime.timedelta(minutes=float(s[:-1]))
        elif s.endswith("s"): delta = datetime.timedelta(seconds=float(s[:-1]))
        else:                 delta = datetime.timedelta(minutes=float(s))
        target = now + delta
    else:
        h, m = spec.split(":")
        target = now.replace(hour=int(h), minute=int(m), second=0, microsecond=0)
        if target <= now:
            target += datetime.timedelta(days=1)
    print(int(target.timestamp()))
except Exception:
    pass
PYEOF
}

scheduler_pane_owned() {
    local pane="$1" expected="${2:-}" owner project tool
    owner="$(tmux show-option -p -v -t "$pane" @codexc_owner 2>/dev/null)"
    case "$owner" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#owner}" -le 10 ] && [ "$owner" -gt 1 ] || return 1
    [ -z "$expected" ] || [ "$owner" = "$expected" ] || return 1
    kill -0 "$owner" 2>/dev/null || return 1
    tool="$(tmux show-option -p -v -t "$pane" @codexc_tool 2>/dev/null)"
    project="$(tmux show-option -p -v -t "$pane" @codexc_project 2>/dev/null)"
    [ "$tool" = "$CODEXC_TOOL" ] && [ "$project" = "$(pwd -P)" ] || return 1
    printf '%s' "$owner"
}

scheduler_pane_busy() {
    local screen
    screen="$(tmux capture-pane -p -t "$1" 2>/dev/null)" || return 0
    case "$CODEXC_TOOL" in
        opencode) ! printf '%s\n' "$screen" | tail -5 | grep -q 'ctrl+p commands' ;;
        *) printf '%s\n' "$screen" | grep -qi 'to interrupt' ;;
    esac
}

run_scheduler() {
    local target="$1" pane="$2" prompt="$3" spec="${4:-$1}" now left owner
    owner="$(scheduler_pane_owned "$pane")" || {
        echo "codexc: scheduled prompt refused: pane is not owned by this project/tool" >&2
        return 1
    }
    case "$target" in ''|*[!0-9]*)
        echo "$(date '+%F %T') scheduler: invalid target for '$spec'" >> "$WATCHLOG"
        return 1
        ;;
    esac
    if [ "${#target}" -gt 12 ]; then
        echo "$(date '+%F %T') scheduler: invalid target for '$spec'" >> "$WATCHLOG"
        return 1
    fi
    target=$((10#$target))
    echo "$(date '+%F %T') scheduler: prompt queued for $pane at $(date -r "$target" '+%F %T') (spec: $spec): $prompt" >> "$WATCHLOG"
    while :; do
        scheduler_pane_owned "$pane" "$owner" >/dev/null || return 1
        now=$(date +%s)
        [ "$now" -ge "$target" ] && break
        [ -n "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ] || {
            echo "$(date '+%F %T') scheduler: pane gone before fire time, giving up" >> "$WATCHLOG"
            return 0
        }
        left=$(( target - now )); [ "$left" -gt 60 ] && left=60
        sleep "$left"
    done
    # fire only into an idle TUI (a running turn shows "esc to interrupt")
    while :; do
        [ -n "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ] || {
            echo "$(date '+%F %T') scheduler: pane gone before send, giving up" >> "$WATCHLOG"
            return 0
        }
        if scheduler_pane_busy "$pane"; then
            sleep 5
            continue
        fi
        sleep 1
        scheduler_pane_owned "$pane" "$owner" >/dev/null || return 1
        scheduler_pane_busy "$pane" && continue
        break
    done
    echo "$(date '+%F %T') scheduler: firing scheduled prompt: $prompt" >> "$WATCHLOG"
    notify "Scheduled prompt fired"
    scheduler_pane_owned "$pane" "$owner" >/dev/null || return 1
    tmux send-keys -t "$pane" -l -- "$prompt" || {
        echo "$(date '+%F %T') scheduler: failed to send prompt text" >> "$WATCHLOG"
        return 1
    }
    sleep 0.4
    scheduler_pane_owned "$pane" "$owner" >/dev/null || return 1
    tmux send-keys -t "$pane" Enter || {
        echo "$(date '+%F %T') scheduler: failed to submit prompt" >> "$WATCHLOG"
        return 1
    }
}

# ---- watcher: runs as a background child inside the codex pane -------------
# $1 = pid to follow (this shell, which blocks on the codex child process)

watch_and_run() {
    local follow_pid="$1" pane="$2"
    local match_re extra_re count=0 ts_last=0 now
    local turn_start="" turn_start_prev="" last_err_notify=0 unrescuable dur human esc last_prompt="" last_hb=0 rediscover_at=0
    local hb_task="⚙︎ 会话在线" hb_active=0 hb_started=0
    local sess_file="" status rollout

    match_re="$TRANSIENT_RE"
    extra_re="$(load_extra_patterns)"
    [ -n "$extra_re" ] && match_re="$match_re|$extra_re"
    # 诊断基线: 记录投喂消息的逐字节形态, "输入了但没发送"类事故可直接对账
    echo "$(date '+%F %T') watcher: message bytes:$(printf '%s' "$CODEXC_MESSAGE" | od -An -c | tr '\n' ' ' | tr -s ' ' | head -c 100)" >> "$WATCHLOG"

    # error source: the session ROLLOUT's task_complete.error events. The
    # sqlite logs table does not carry model-availability errors ("Selected
    # model is at capacity" etc.) — verified on codex 0.162 — so the rollout
    # tail is the authoritative feed. Claude/pi watchers use the same shape.
    rollout=""
    tries=0
    while :; do
        rollout="$(watcher_find_rollout "$pane")"
        [ -n "$rollout" ] && break
        kill -0 "$follow_pid" 2>/dev/null || return 0
        # 闲置会话 (无新写入) 找不到活跃 rollout 是常态 — 跟随进程存活就持续
        # 等, 用户提交任务后 rollout mtime 变新即被发现; 不再按次数放弃
        tries=$((tries + 1))
        [ "$tries" = "30" ] && echo "$(date '+%F %T') watcher: no rollout yet — waiting for session activity" >> "$WATCHLOG"
        sleep "$CODEXC_POLL"
    done
    sess_file="$rollout"
    sess_off="$(stat -f '%z' "$sess_file" 2>/dev/null || echo 0)"   # skip history

    # 中途接入 (attach 换挂/恢复): rollout 尾部若存在未配对的 task_started,
    # 说明回合已在跑 — 起点取 started_at, 任务文本取最近的 UserMessage。
    # 成本控制: 子串预过滤替代全量 json 解析; 先扫 32MB 尾窗, 不够再 4 倍
    # 扩宽 (数小时长回合的 task_started 会沉得很深)
    infer="$(python3 - "$sess_file" <<'PYEOF4'
import json, os, sys
path = sys.argv[1]
size = os.path.getsize(path)
window = 32 << 20
started_at = None
prompt = ""
while True:
    w = min(window, size)
    with open(path, "rb") as fh:
        fh.seek(size - w)
        data = fh.read().decode("utf-8", "replace")
    lines = data.split("\n")
    if w < size and lines:
        lines = lines[1:]                     # 尾窗首行可能是半行, 丢弃
    done = False
    for line in reversed(lines):
        if "task_" not in line and '"UserMessage"' not in line:
            continue                          # 子串预过滤, 避开大行 json 解析
        try: d = json.loads(line)
        except Exception: continue
        p = d.get("payload") if isinstance(d, dict) else None
        if not isinstance(p, dict): continue
        pt = p.get("type")
        if pt == "task_complete" and started_at is None:
            done = True                       # 最新回合已完成 → 不活跃
            break
        if pt == "task_started" and started_at is None:
            sa = p.get("started_at")
            started_at = int(sa) if isinstance(sa, (int, float)) else 0
            continue                          # 起点已记, 继续回扫任务文本
        if pt == "item_completed" and not prompt:
            item = p.get("item")
            if isinstance(item, dict) and item.get("type") == "UserMessage":
                c = item.get("content")
                if isinstance(c, list):
                    for x in c:
                        if isinstance(x, dict) and x.get("type") == "text":
                            prompt = " ".join(str(x.get("text") or "").split())[:120]
                            break
            if started_at is not None and prompt:
                done = True
                break
    if done or window >= size:
        break
    window *= 4
print(f"{started_at or 0}\t{prompt}")
PYEOF4
)"
    turn_start="$(printf '%s' "$infer" | cut -f1)"
    last_prompt="$(printf '%s' "$infer" | cut -f2)"
    case "$turn_start" in ''|0) turn_start="" ;; esac
    [ -n "$turn_start" ] && write_status "▶️ $last_prompt" 1 "$turn_start"

    while kill -0 "$follow_pid" 2>/dev/null; do
        sleep "$CODEXC_POLL"
        now="$(date +%s)"
        # 心跳: 回合进行中每 30s 刷新 status.json (悬浮条新鲜窗口 120s;
        # 事件写入不受此限), 不依赖本轮是否读到新事件
        if [ $((now - last_hb)) -ge 30 ]; then
            write_status "$hb_task" "$hb_active" "$hb_started"
            last_hb=$now
        fi
        # /resume 换文件检测降频到 30s 一次 (lsof 扫树不便宜)
        if [ "$now" -ge "$rediscover_at" ]; then
            rediscover_at=$((now + 30))
            newest="$(watcher_find_rollout "$pane")"
            if [ -n "$newest" ] && [ "$newest" != "$sess_file" ]; then
                sess_file="$newest"
                sess_off=-1                   # -1 = 从新文件 EOF 起步 (跳过历史)
            fi
        fi
        cur="$(stat -f '%z' "$sess_file" 2>/dev/null || echo 0)"
        [ "$cur" -ne "$sess_off" ] || continue
        out="$(python3 - "$sess_file" "$sess_off" <<'PYEOF6'
import json, os, sys
path = sys.argv[1]
offset = int(sys.argv[2])
size = os.path.getsize(path)
if offset < 0 or offset > size:
    offset = size                              # -1 = 新文件跳过历史; 缩小 = 被截断, 就地重置
if size <= offset:
    print(offset)
    raise SystemExit
with open(path, "rb") as fh:
    fh.seek(offset)
    raw = fh.read(size - offset)
parts = raw.split(b"\n")
consumed = offset + len(raw) - len(parts[-1])  # 末段无换行 = 半行, 留在水位外
out = []
for b in parts[:-1]:
    line = b.decode("utf-8", "replace")
    if not line:
        continue
    try: d = json.loads(line)
    except Exception: continue
    payload = d.get("payload") if isinstance(d, dict) else None
    if not isinstance(payload, dict): continue
    ptype = payload.get("type")
    if ptype == "task_started":
        out.append("start\t")
        continue
    if ptype == "item_completed":
        item = payload.get("item")
        if isinstance(item, dict) and item.get("type") == "UserMessage":
            text = ""
            content = item.get("content")
            if isinstance(content, list):
                for c in content:
                    if isinstance(c, dict) and c.get("type") == "text":
                        text = c.get("text") or ""
                        break
            out.append("prompt\t" + " ".join(str(text).split())[:120])
        continue
    if ptype != "task_complete": continue
    err = payload.get("error")
    if err:
        text = err.get("message", "") if isinstance(err, dict) else str(err)
        out.append("err\t" + " ".join(str(text).split())[:200])
    else:
        msg = payload.get("last_agent_message") or ""
        out.append("done\t" + " ".join(str(msg).split())[:80])
print(consumed)
for e in out:
    print(e)
PYEOF6
)"
        sess_off="$(printf '%s' "$out" | head -1)"
        case "$sess_off" in ''|*[!0-9]*) sess_off=-1; continue ;; esac
        status="$(printf '%s' "$out" | tail -n +2)"
        [ -n "$status" ] || continue
        while IFS=$TAB read -r api_code api_text; do
            case "$api_code" in
                start)
                    turn_start="$(date +%s)"
                    write_status "▶️ $last_prompt" 1 "$turn_start"
                    continue ;;
                prompt)
                    [ -n "$api_text" ] && last_prompt="$api_text"
                    [ -n "$turn_start" ] && write_status "▶️ $last_prompt" 1 "$turn_start"
                    continue ;;
                done)
                    turn_start_prev="$turn_start"; turn_start=""
                    write_status "✅ 完成: $api_text" 0 "${turn_start_prev:-0}"
                    [ "$CODEXC_NOTIFY" = "1" ] && [ -n "$turn_start_prev" ] || continue
                    now="$(date +%s)"; dur=$((now - turn_start_prev))
                    [ "$dur" -ge "$CODEXC_NOTIFY_SECS" ] || continue
                    human="$((dur / 60))m$((dur % 60))s"
                    notify "✅ 任务完成 (${human}): ${api_text:0:60}"
                    echo "$(date '+%F %T') notified: task completed (${human}): ${api_text:0:80}" >> "$WATCHLOG"
                    continue ;;
                err) ;;
                *) continue ;;
            esac
            [ -n "$api_text" ] || continue
            echo "$(date '+%F %T') codex turn error: ${api_text:0:100}" >> "$WATCHLOG"
            now="$(date +%s)"
            # 分流: usage limit / 未知错误 = 不可自动续跑 (通知用户处理, 60s 节流);
            # 瞬态错误静默走自动续跑
            if printf '%s\n' "$api_text" | grep -qiE "$BLOCK_RE"; then
                unrescuable=1
            elif printf '%s\n' "$api_text" | grep -qiE "$match_re"; then
                unrescuable=0
            else
                unrescuable=1
            fi
            if [ "$unrescuable" = "1" ]; then
                write_status "⛔ codex 停了: $api_text" 0 "${turn_start:-0}"
                if [ "$CODEXC_NOTIFY" = "1" ] && [ $((now - last_err_notify)) -ge 60 ]; then
                    notify "⛔ codex 停了: ${api_text:0:60}"
                    echo "$(date '+%F %T') notified: unrescuable error: ${api_text:0:80}" >> "$WATCHLOG"
                    last_err_notify=$now
                fi
            fi
            [ "$unrescuable" = "1" ] && continue
            now=$(date +%s)
            while [ $((now - ts_last)) -lt "$CODEXC_COOLDOWN" ]; do
                sleep 1
                kill -0 "$follow_pid" 2>/dev/null || return 0
                now=$(date +%s)
            done
            if [ "$count" -ge "$CODEXC_MAX_CONTINUES" ]; then
                notify "Auto-continued $count times, pausing auto-retry"
                echo "$(date '+%F %T') reached max continues ($count), stopping" >> "$WATCHLOG"
                return 0
            fi
            [ -n "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ] || { echo "$(date '+%F %T') pane gone, watcher stopping" >> "$WATCHLOG"; return 0; }
            if tmux capture-pane -p -t "$pane" 2>/dev/null | grep -q "to interrupt"; then
                echo "$(date '+%F %T') turn still active, skipping send" >> "$WATCHLOG"
                continue
            fi
            sleep 3
            [ -n "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null)" ] || return 0
            tmux capture-pane -p -t "$pane" 2>/dev/null | grep -q "to interrupt" && continue
            echo "$(date '+%F %T') Turn error in rollout -> auto-continue #$((count+1)): ${api_text:0:80}" >> "$WATCHLOG"
            kill -0 "$follow_pid" 2>/dev/null || return 0
            tmux send-keys -t "$pane" -l -- "$CODEXC_MESSAGE" || return 0
            sleep 0.4
            kill -0 "$follow_pid" 2>/dev/null || return 0
            tmux send-keys -t "$pane" Enter || return 0
            count=$((count + 1)); ts_last=$(date +%s)
        done <<EOF
$status
EOF
    done
    echo "$(date '+%F %T') codex exited, watcher stopping" >> "$WATCHLOG"
}

write_status() {  # $1=任务文本 $2=active(1/0) $3=started_at epoch(0=未知)
    # 记录最近一次写入的载荷 — 心跳(30s)反复广播它, 会话关闭后随之过期
    hb_task="$1"; hb_active="$2"; hb_started="${3:-0}"
    local driver
    driver="$(cat .codingkeeper/loop.pid 2>/dev/null || true)"
    case "$driver" in ''|*[!0-9]*) ;; *) kill -0 "$driver" 2>/dev/null && return 0 ;; esac
    mkdir -p ".codingkeeper" 2>/dev/null
    python3 - "$PWD" "$1" "${CODEXC_TOOL:-codex}" "${2:-0}" "${3:-0}" "$SCRIPT_DIR/ck-leaf.py" <<'PYEOF3'
import importlib.util, json, os, sys, time, tempfile
pdir, project, task = ".codingkeeper", sys.argv[1], sys.argv[2]
# 口喷长文只留标识头: 32 字符 + … (bash 3.2 的 ${v:0:N} 按字节切会碎多字节,
# 截断必须在 python 按字符做)
task = " ".join(str(task).split())
if len(task) > 32:
    task = task[:30].rstrip() + "…"
tool, active, started_at = sys.argv[3], sys.argv[4] == "1", int(sys.argv[5] or 0)
parked = os.path.exists(os.path.join(pdir, "loop.halt"))
# ready 口径 = 仅 ## ready 区 (与 ck-common status_write 一致)
ready = 0
try:
    spec = importlib.util.spec_from_file_location("leaf", sys.argv[6])
    leaf = importlib.util.module_from_spec(spec); spec.loader.exec_module(leaf)
    ready = leaf.queue_stats(leaf.read_queue(os.path.join(pdir, "queue.md")))["ready"]
except (OSError, ValueError, UnicodeError):
    pass
snap = {"project": project, "task": task, "phase": task, "parked": parked,
        "tool": tool, "active": active, "started_at": started_at,
        "ready": ready,
        "ts": int(time.time())}
# 原子替换: 桌面面板每 2s 轮询本文件, 非原子写会被读到半截 JSON
fd, tmp = tempfile.mkstemp(prefix=".status-", dir=pdir)
try:
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(snap, fh, ensure_ascii=False)
    os.replace(tmp, os.path.join(pdir, "status.json"))
finally:
    if os.path.exists(tmp): os.unlink(tmp)
PYEOF3
    return 0
}

spawn_watcher() {  # $1=owner pid $2=pane; result in SPAWNED_WATCHER_PID
    local fp="$1" pane="$2"
    SPAWNED_WATCHER_PID=""
    (CK_LANE=codexc; . "$SCRIPT_DIR/ck-common.sh"; register_project)
    # The launcher redirects every child descriptor before returning the PID.
    # Only the short-lived Python launcher is captured, never a background shell.
    SPAWNED_WATCHER_PID="$(CODEXC_TOOL="$CODEXC_TOOL" CODEX_HOME="$CODEX_HOME_DIR" \
        CODEXC_POLL="$CODEXC_POLL" CODEXC_NOTIFY="$CODEXC_NOTIFY" CODEXC_NOTIFY_SECS="$CODEXC_NOTIFY_SECS" \
        CODEXC_COOLDOWN="$CODEXC_COOLDOWN" CODEXC_MAX_CONTINUES="$CODEXC_MAX_CONTINUES" \
        CODEXC_MESSAGE="$CODEXC_MESSAGE" CODEXC_EXTRA_RE="$CODEXC_EXTRA_RE" \
        CLAUDE_CONFIG_DIR="$CLAUDE_DIR" PI_DIR="$PI_DIR" OPENCODE_DATA_DIR="$OPENCODE_DIR" \
        python3 "$SCRIPT_DIR/ck-watcher.py" "$SELF" "$pane" "$fp" "$WATCHLOG")" || return 1
    echo "$(date '+%F %T') watcher: spawned (pid $SPAWNED_WATCHER_PID pane $pane follow $fp)" >> "$WATCHLOG"
}

# the watcher's rollout discovery: newest sessions/*.jsonl held open inside
# the pane's process tree (same approach as codexc-loop)
watcher_find_rollout() {  # $1=pane -> prints path or nothing
    local pane="$1" root_pids all p f m newest="" newest_m=0 lsof_out
    local home_log="$CODEX_HOME_DIR" home_phys
    home_phys="$(cd "$CODEX_HOME_DIR" 2>/dev/null && pwd -P)"
    root_pids="$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null)"
    [ -n "$root_pids" ] || return 0
    all="$root_pids"
    local frontier="$root_pids" next child
    for _ in 1 2 3; do
        next=""
        for p in $frontier; do
            for child in $(pgrep -P "$p" 2>/dev/null); do
                case " $all " in *" $child "*) ;; *) all="$all $child"; next="$next $child" ;; esac
            done
        done
        [ -n "$next" ] || break
        frontier="$next"
    done
    lsof_out="$(mktemp "${TMPDIR:-/tmp}/codexc-watcher.XXXXXX")" || return 0
    local pid_csv
    pid_csv="$(printf '%s' "$all" | tr ' ' ',')"
    lsof -Fn -p "$pid_csv" 2>/dev/null | sed -n 's/^n//p' > "$lsof_out"
    while IFS= read -r f; do
        # macOS /tmp -> /private/tmp etc.: the fd path is physical while
        # CODEX_HOME may be logical — accept both forms
        # codex 新版把 rollout 放进日期子目录 (sessions/YYYY/MM/DD/) — 按前缀
        # + .jsonl 后缀匹配任意深度, 扁平 glob 会静默失明
        case "$f" in
            "$home_log"/sessions/*|"$home_phys"/sessions/*) ;;
            *) continue ;;
        esac
        case "$f" in
            *.jsonl) ;;
            *) continue ;;
        esac
        m=$(stat -f '%m' "$f" 2>/dev/null || echo 0)
        [ "$m" -gt "$newest_m" ] && newest_m=$m && newest="$f"
    done < "$lsof_out"
    rm -f "$lsof_out"
    # codex 更新版本写入即关, 不再持有 fd — lsof 路径会空手而归。fallback:
    # 找 5 分钟内活跃的 rollout, 用文件头 session_meta.cwd 匹配当前项目
    # (多项目并行各认各的会话, 不误抢别家的)
    if [ -z "$newest" ]; then
        newest="$(python3 - "$CODEX_HOME_DIR/sessions" "$PWD" <<'PYEOF5'
import json, os, sys, time

root, proj = sys.argv[1], os.path.realpath(sys.argv[2])
if not os.path.isdir(root):
    raise SystemExit(0)
now = time.time()
cands = []
for current, dirs, files in os.walk(root, onerror=lambda _e: None):
    for name in files:
        if not name.endswith(".jsonl"):
            continue
        path = os.path.join(current, name)
        try:
            info = os.stat(path)
        except OSError:
            continue
        if now - info.st_mtime <= 300:
            cands.append((info.st_mtime, path))
cands.sort(reverse=True)
for _mtime, path in cands:
    try:
        with open(path, encoding="utf-8") as fh:
            meta = json.loads(fh.readline())
        payload = meta.get("payload")
        cwd = payload.get("cwd") if isinstance(payload, dict) else None
        cwd = cwd or meta.get("cwd") or ""
        if os.path.realpath(cwd) == proj:
            print(path)
            break
    except Exception:
        continue
PYEOF5
)"
    fi
    [ -n "$newest" ] && printf '%s' "$newest"
}

# Optional tool adapters share the loop's discovery/schema helpers.
if [ -f "$SCRIPT_DIR/ck-watch-tools.sh" ]; then
    . "$SCRIPT_DIR/ck-watch-tools.sh"
fi

# ---- internal: standalone watcher entry (live restart of long sessions) -----
# codexc __watcher_run <pane-id> <codex-pid>: re-arms the rollout-tail
# watcher for a session whose watcher predates a code update; the follow pid
# is the codex process itself, so the watcher exits when codex exits.
if [ "${1:-}" = "__watcher_run" ]; then
    [ $# -ge 3 ] || { echo "codexc: __watcher_run needs <pane-id> <codex-pid>" >&2; exit 1; }
    prepare_watch_log || exit 1
    echo "$(date '+%F %T') watcher: standalone watcher armed on pane $2 (codex pid $3)" >> "$WATCHLOG"
    case "$CODEXC_TOOL" in
        claude) watch_and_run_claude "$3" "$2" ;;
        pi) watch_and_run_pi "$3" "$2" ;;
        opencode) watch_and_run_opencode "$3" "$2" ;;
        *) watch_and_run "$3" "$2" ;;
    esac
    exit $?
fi

# ---- internal: detached scheduler entry ------------------------------------
# codexc calls this via nohup to queue a scheduled prompt into an
# already-running session; not a documented interface.
if [ "${1:-}" = "__schedule_run" ]; then
    [ $# -ge 4 ] || { echo "codexc: __schedule_run needs <epoch> <pane> <prompt>" >&2; exit 1; }
    command -v tmux >/dev/null || { echo "codexc: tmux is required" >&2; exit 1; }
    prepare_watch_log || { echo "codexc: cannot prepare private Codex home/log '$CODEX_HOME_DIR'" >&2; exit 1; }
    run_scheduler "$2" "$3" "$4"
    exit $?
fi

# ---- argument parsing (outside tmux) ---------------------------------------
# -n/--name takes the next arg as an explicit session name; "ls" lists
# sessions; anything else is passed through to codex unchanged. Without an
# explicit name the session is auto-resolved from the current directory.
ACTION=""
NO_LOOP=0
while [ $# -gt 0 ]; do
    case "$1" in
        -n|--name)
            [ $# -ge 2 ] && [ -n "$2" ] || { echo "codexc: $1 requires a session name" >&2; exit 1; }
            CODEXC_SESSION="$2"; shift 2 ;;
        -t|--at)
            [ $# -ge 2 ] && [ -n "$2" ] || { echo "codexc: $1 requires a time (HH:MM or +N[h|m|s])" >&2; exit 1; }
            CODEXC_AT="$2"; shift 2 ;;
        codex) shift; break ;;
        loop) ACTION="loop"; shift ;;
        --no-loop) NO_LOOP=1; CODEXC_LOOP=0; shift ;;
        -T|--tool)
            [ $# -ge 2 ] && [ -n "$2" ] || { echo "codexc: $1 requires a tool (codex|claude|pi|opencode)" >&2; exit 1; }
            CODEXC_TOOL="$2"; shift 2 ;;
        fuel) ACTION="fuel"; shift ;;
        status) ACTION="status"; shift ;;
        ls)  ACTION="ls"; shift ;;
        -h|--help|help) ACTION="help"; shift ;;
        *)   break ;;
    esac
done

case "$CODEXC_TOOL" in
    codex|claude|pi|opencode) ;;
    *) echo "codexc: unsupported tool '$CODEXC_TOOL' (use codex|claude|pi|opencode)" >&2; exit 1 ;;
esac

export CODEXC_TOOL

if [ "$ACTION" = "help" ]; then
    usage; exit 0
fi
if [ "$ACTION" = "ls" ]; then
    command -v tmux >/dev/null || { echo "codexc: tmux is required" >&2; exit 1; }
    tmux ls 2>/dev/null || echo "codexc: no tmux sessions (tmux server not started?)" >&2
    exit 0
fi
if [ "$ACTION" = "status" ]; then
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    worker="$self_dir/codexc-headless"
    [ -x "$worker" ] || worker="$(command -v codexc-headless 2>/dev/null || echo codexc-headless)"
    exec "$worker" status "$@"
fi
if [ "$ACTION" = "fuel" ]; then
    command -v sqlite3 >/dev/null || { echo "codexc: sqlite3 is required" >&2; exit 1; }
    FUEL_TOOL="${1:-$CODEXC_TOOL}"
    case "$FUEL_TOOL" in codex|claude|pi|opencode) ;; *) echo "codexc fuel: unknown tool '$FUEL_TOOL' (codex|claude|pi|opencode)" >&2; exit 1 ;; esac
    db="$HOME/.cc-switch/cc-switch.db"
    if [ ! -f "$db" ]; then
        echo "codexc fuel: cc-switch 数据库不存在 ($db) — 没有煤仓可显示"
        exit 0
    fi
    q() { sqlite3 -readonly -cmd '.timeout 2000' "$db" "$1" 2>/dev/null; }
    echo "== 锅炉燃料表 $FUEL_TOOL $(date '+%F %T') =="
    cur="$(q "SELECT name FROM providers WHERE app_type='$FUEL_TOOL' AND is_current=1 LIMIT 1")"
    echo "当前煤: ${cur:-<无>}"
    row="$(q "SELECT proxy_enabled, enabled, auto_failover_enabled, max_retries FROM proxy_config WHERE app_type='$FUEL_TOOL'")"
    if [ -n "$row" ]; then
        on="$(echo "$row" | cut -d'|' -f1)"
        failover="$(echo "$row" | cut -d'|' -f3)"
        retries="$(echo "$row" | cut -d'|' -f4)"
        echo "中转(127.0.0.1:15721): 启用=$on 自动换煤=$failover 单provider重试=$retries"
        [ "$failover" = "0" ] && echo "  ⚠ 自动换煤未开启 — 煤烧完只会熄火 (在 cc-switch 里启用并往队列加煤)"
    fi
    queue="$(q "SELECT group_concat(name, ' → ') FROM (SELECT name FROM providers WHERE app_type='$FUEL_TOOL' AND in_failover_queue=1 ORDER BY sort_index)")"
    echo "换煤队列: ${queue:-（空）}"
    unhealthy="$(q "SELECT p.name||' (连续失败 '||h.consecutive_failures||')' FROM provider_health h JOIN providers p ON p.id=h.provider_id AND p.app_type=h.app_type WHERE h.app_type='$FUEL_TOOL' AND (h.is_healthy=0 OR h.consecutive_failures>0) ORDER BY h.consecutive_failures DESC")"
    if [ -n "$unhealthy" ]; then
        echo "不健康的煤:"
        printf '  %s\n' "$unhealthy"
    fi
    # spend from proxy_request_logs (authoritative, epoch created_at); the
    # usage_daily_rollups table does not carry codex rows in this setup
    spend="$(q "SELECT round(sum(CAST(total_cost_usd AS REAL)),2)||' USD / '||count(*)||' req' FROM proxy_request_logs WHERE app_type='$FUEL_TOOL' AND created_at>=strftime('%s','now','localtime','start of day')")"
    echo "今日消耗: ${spend:-0 USD / 0 req} (relay 日志落库有秒级延迟)"
    spend="$(q "SELECT round(sum(CAST(total_cost_usd AS REAL)),2)||' USD / '||count(*)||' req' FROM proxy_request_logs WHERE app_type='$FUEL_TOOL' AND created_at>=strftime('%s','now','localtime','start of month')")"
    echo "本月消耗: ${spend:-0 USD / 0 req}"
    errs="$(q "SELECT datetime(l.created_at,'unixepoch','localtime')||' ['||l.status_code||'] '||p.name||': '||substr(coalesce(l.error_message,''),1,70) FROM proxy_request_logs l JOIN providers p ON p.id=l.provider_id AND p.app_type=l.app_type WHERE l.app_type='$FUEL_TOOL' AND l.status_code>=400 ORDER BY l.created_at DESC LIMIT 3")"
    if [ -n "$errs" ]; then
        echo "最近中转错误:"
        printf '  %s\n' "$errs"
    fi
    if [ -e ".codingkeeper/loop.halt" ]; then
        echo "codexc 循环: 挂起 (.codingkeeper/loop.halt 存在 — rm 后复燃)"
    elif [ -f ".codingkeeper/queue.md" ]; then
        ready="$(python3 "$SCRIPT_DIR/ck-leaf.py" count .codingkeeper/queue.md 2>/dev/null)"
        echo "codexc 循环: 队列就绪 (${ready:-0} 个待投喂任务)"
    fi
    exit 0
fi
if [ "$ACTION" = "loop" ]; then
    [ "$NO_LOOP" = "1" ] || CODEXC_LOOP=1
    ACTION=""
fi
if [ "$CODEXC_LOOP" = "1" ] && [ -n "$CODEXC_AT" ]; then
    echo "codexc: choose either a scheduled prompt (-t) or the delivery loop per session" >&2
    exit 1
fi
command -v tmux    >/dev/null || { echo "codexc: tmux is required" >&2; exit 1; }
command -v sqlite3 >/dev/null || { echo "codexc: sqlite3 is required" >&2; exit 1; }
command -v python3 >/dev/null || { echo "codexc: python3 is required" >&2; exit 1; }
prepare_watch_log || { echo "codexc: cannot prepare private Codex home/log '$CODEX_HOME_DIR'" >&2; exit 1; }
# scheduled mode: everything left on the command line is the prompt to fire
if [ -n "$CODEXC_AT" ]; then
    [ "$#" -eq 0 ] || CODEXC_PROMPT="$*"
    if [ -z "$CODEXC_PROMPT" ]; then
        echo "codexc: -t needs a prompt, e.g. codexc -t 10:00 \"continue the task\"" >&2
        exit 1
    fi
    case "$CODEXC_TARGET" in
        ''|*[!0-9]*) CODEXC_TARGET="$(parse_schedule_epoch "$CODEXC_AT")" ;;
    esac
    if [ -z "$CODEXC_TARGET" ]; then
        echo "codexc: invalid time '$CODEXC_AT' (use HH:MM or +N[h|m|s])" >&2
        exit 1
    fi
    if [ "${#CODEXC_TARGET}" -gt 12 ]; then
        echo "codexc: invalid scheduled target for '$CODEXC_AT'" >&2
        exit 1
    fi
    set --   # the prompt goes to the scheduler, not to codex's argv
fi

if [ -z "$CODEXC_SESSION" ]; then
    CODEXC_SESSION="$(resolve_session_name)"
fi

if [ "$CODEXC_TOOL" = "claude" ] && [ "${1:-}" = "resume" ] && [ "${2:-}" = "--last" ]; then
    shift 2            # claude speaks --continue, not `resume --last`
    set -- --continue "$@"
fi

# Stale TMUX/TMUX_PANE can survive a server restart or inherited environment.
# Only run in place when this exact pane still exists on that server.
if [ -n "${TMUX:-}" ]; then
    inherited_pane=""
    if [ -n "${TMUX_PANE:-}" ]; then
        inherited_pane="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_id}' 2>/dev/null)"
    fi
    if [ -z "$inherited_pane" ] || [ "$inherited_pane" != "${TMUX_PANE:-}" ]; then
        unset TMUX TMUX_PANE
    fi
fi

# ---- inside tmux: run codex + watcher (+ optional scheduler) in this pane --
if [ -n "${TMUX:-}" ]; then
    case "$CODEXC_TOOL" in
        claude)   command -v claude   >/dev/null || { echo "codexc: claude CLI is required" >&2; exit 1; } ;;
        pi)       command -v pi       >/dev/null || { echo "codexc: pi CLI is required" >&2; exit 1; } ;;
        opencode) command -v opencode >/dev/null || { echo "codexc: opencode CLI is required" >&2; exit 1; } ;;
        *)        command -v codex    >/dev/null || { echo "codexc: codex CLI is required" >&2; exit 1; } ;;
    esac
    PANE="$(tmux display-message -p -t "${TMUX_PANE:-}" '#{pane_id}')"
    [ -n "$PANE" ] || { echo "codexc: tmux pane is unavailable; open a fresh terminal and retry" >&2; exit 1; }
    tmux set-option -p -t "$PANE" @codexc_tool "$CODEXC_TOOL"
    tmux set-option -p -t "$PANE" @codexc_project "$(pwd -P)"
    tmux set-option -p -t "$PANE" @codexc_owner "$$"
    case "$CODEXC_TOOL" in
        claude) seed_claude_trust || exit 1 ;;
        codex) ensure_retry_config && ensure_project_trust || exit 1 ;;
        *)      : ;;
    esac
    sched_pid=""
    if [ -n "$CODEXC_AT" ]; then
        CODEXC_PROMPT="${CODEXC_PROMPT:-$*}"
        [ -n "$CODEXC_PROMPT" ] || { echo "codexc: scheduled mode needs a prompt" >&2; exit 1; }
        ( run_scheduler "$CODEXC_TARGET" "$PANE" "$CODEXC_PROMPT" "$CODEXC_AT" >> "$WATCHLOG" 2>&1 ) &
        sched_pid=$!
        set --   # the prompt goes to the scheduler, not to codex's argv
    fi
    # A background watcher must never be started inside command substitution:
    # inherited output pipes otherwise keep the launcher waiting for EOF.
    watcher=""
    if ! spawn_watcher "$$" "$PANE"; then
        echo "codexc: watcher unavailable; see $WATCHLOG" >&2
    fi
    watcher="${SPAWNED_WATCHER_PID:-}"
    loop_pid=""
    night_pid=""
    if [ "${CODEXC_LOOP:-0}" = "1" ] && [ -n "$CODEXC_AT" ]; then
        echo "codexc: warning — scheduled prompt (-t) and the delivery loop both feed this TUI; they can interleave. Prefer one." >&2
    fi
    if [ "${CODEXC_LOOP:-0}" = "1" ]; then
        loop_bin="$(dirname "$0")/codexc-loop"
        [ -x "$loop_bin" ] || loop_bin="$(command -v codexc-loop 2>/dev/null || true)"
        if [ -n "$loop_bin" ] && [ -x "$loop_bin" ]; then
            if [ ! -f ".codingkeeper/queue.md" ]; then
                "$loop_bin" init >> "$WATCHLOG" 2>&1
                echo "$(date '+%F %T') loop: auto-init (队列/门禁已按项目探测生成)" >> "$WATCHLOG"
            fi
            ( "$loop_bin" run "$PANE" >> "$WATCHLOG" 2>&1 ) &
            loop_pid=$!
            echo "$(date '+%F %T') loop: driver spawned (pid $loop_pid)" >> "$WATCHLOG"
        else
            echo "codexc: CODEXC_LOOP=1 but codexc-loop not found — running without the delivery loop" >&2
        fi
    else
        if [ "$NO_LOOP" != "1" ] && [ -z "$CODEXC_AT" ] && [ "${CODEXC_NIGHT_IDLE:-600}" != "0" ]; then
            python3 "$SCRIPT_DIR/ck-night-loop.py" "$PANE" "$$" "$CODEXC_TOOL" >> "$WATCHLOG" 2>&1 &
            night_pid=$!
        fi
        if [ -f ".codingkeeper/queue.md" ]; then
            ready_q="$(python3 "$SCRIPT_DIR/ck-leaf.py" count .codingkeeper/queue.md 2>/dev/null || true)"
            echo "codexc: delivery loop off — ${ready_q:-0} 个就绪任务未投喂 (codexc loop 显式开启)" >&2
        fi
    fi
    # auto-yes: official flags skip all approval prompts; never override
    # approval/sandbox flags the user passed explicitly
    codex_flags=""
    if ! has_explicit_auto_mode "$@"; then
        case "$CODEXC_TOOL" in
            claude)
                case "$CODEXC_AUTO_YES" in
                    1) codex_flags="--dangerously-skip-permissions" ;;
                    2) codex_flags="--permission-mode acceptEdits" ;;
                esac
                ;;
            opencode)
                case "$CODEXC_AUTO_YES" in
                    1) codex_flags="--auto" ;;
                esac
                ;;
            codex)
                case "$CODEXC_AUTO_YES" in
                    1) codex_flags="--dangerously-bypass-approvals-and-sandbox" ;;
                    2) codex_flags="--ask-for-approval never --sandbox workspace-write" ;;
                esac
                ;;
            pi) : ;;
        esac
    fi
    case "$CODEXC_TOOL" in
        claude)   claude   $codex_flags "$@" ;;
        pi)       pi       $codex_flags "$@" ;;
        opencode) opencode $codex_flags "$@" ;;
        *)        codex    $codex_flags "$@" ;;
    esac
    rc=$?
    [ -n "$watcher" ] && kill "$watcher" 2>/dev/null
    [ -n "$sched_pid" ] && kill "$sched_pid" 2>/dev/null
    [ -n "$loop_pid" ] && kill "$loop_pid" 2>/dev/null
    [ -n "$night_pid" ] && kill "$night_pid" 2>/dev/null
    exit $rc
fi

# ---- outside tmux: create a session running this script, then attach ------
if tmux has-session -t "=$CODEXC_SESSION" 2>/dev/null; then
    existing_path="$(tmux display-message -p -t "=$CODEXC_SESSION:" '#{session_path}')"
    existing_phys="$(cd "$existing_path" 2>/dev/null && pwd -P)"
    existing_tool="$(tmux show-option -p -v -t "=$CODEXC_SESSION:" @codexc_tool 2>/dev/null || true)"
    if [ "$existing_phys" != "$(pwd -P)" ] || ! session_tool_matches "$CODEXC_SESSION"; then
        echo "codexc: session '$CODEXC_SESSION' belongs to another project or tool; choose a different name with -n" >&2
        exit 1
    fi
    if [ "$#" -gt 0 ]; then
        echo "codexc: attaching existing session; arguments apply only when starting a new session (use -n to choose a new name)" >&2
    fi
    # session already running: queue the scheduled prompt into it from a
    # detached helper so it survives this client attaching/detaching
    if [ -n "$CODEXC_AT" ]; then
        sched_pane="$(tmux display-message -p -t "=$CODEXC_SESSION:" '#{pane_id}')"
        scheduler_pane_owned "$sched_pane" >/dev/null || { echo "codexc: cannot schedule into an unowned pane; restart its codexc session first" >&2; exit 1; }
        nohup "$SELF" __schedule_run "$CODEXC_TARGET" "$sched_pane" "$CODEXC_PROMPT" >> "$WATCHLOG" 2>&1 &
        echo "codexc: scheduled ${CODEXC_AT} queued into session '${CODEXC_SESSION}' (log: ${WATCHLOG})" >&2
    fi
    # Reuse a verified live watcher; replace a missing watcher without touching
    # an unrelated PID from a project file. Existing code stays until restart.
    attach_pane="$(tmux display-message -p -t "=$CODEXC_SESSION:" '#{pane_id}')"
    attach_owner="$(scheduler_pane_owned "$attach_pane")"
    if [ -n "$attach_owner" ]; then
        spawn_watcher "$attach_owner" "$attach_pane" >/dev/null
    else
        echo "codexc: legacy session attached; restart it to enable the current watcher" >&2
    fi
    exec tmux attach -t "=$CODEXC_SESSION"
fi

case "$CODEXC_TOOL" in
    claude)   command -v claude   >/dev/null || { echo "codexc: claude CLI is required for CODEXC_TOOL=claude" >&2; exit 1; } ;;
    pi)       command -v pi       >/dev/null || { echo "codexc: pi CLI is required for CODEXC_TOOL=pi" >&2; exit 1; } ;;
    opencode) command -v opencode >/dev/null || { echo "codexc: opencode CLI is required for CODEXC_TOOL=opencode" >&2; exit 1; } ;;
    *)        command -v codex    >/dev/null || { echo "codexc: codex CLI is required" >&2; exit 1; } ;;
esac

codex_args=""
[ $# -gt 0 ] && codex_args="$(printf '%q ' "$@")"

# A long-lived tmux server carries the environment from its first client.
# Clear supported settings there, then apply this invocation's values explicitly.
inner_env=""
for setting in CODEXC_NOTIFY CODEXC_NOTIFY_SECS CODEXC_NOTIFY_GAP CODEXC_LOOP_NOTIFY CODEXC_LOOP_POLL CODEXC_LOOP_STALL CODEXC_TURN_TIMEOUT CODEXC_LOOP_DRY CODEXC_LOOP_IDLE CODEXC_IDLE_PARK CODEXC_LOOP_ROLLOUT CODEXC_GATE_TIMEOUT CODEXC_GATE_RETRIES CODEXC_REVIEW_CMD CODEXC_REVIEW_PASS CODEXC_REVIEW_ROUNDS CODEXC_REVIEW_TIMEOUT CODEXC_BANNER CODEXC_PROMPT_ROTATION CODEXC_REQUIRE_GATE CODEXC_NIGHT_IDLE CODEXC_NIGHT_WINDOW CODEXC_NIGHT_TZ CODEXC_ACTIVE_WINDOW CODEXC_ACTIVE_TZ PI_DIR OPENCODE_DATA_DIR; do
    inner_env="$inner_env -u $setting"
done
inner="env$inner_env PATH=$(printf '%q' "$PATH") \
CODEXC_MESSAGE=$(printf '%q' "$CODEXC_MESSAGE") \
CODEXC_COOLDOWN=$CODEXC_COOLDOWN \
CODEXC_MAX_CONTINUES=$CODEXC_MAX_CONTINUES \
CODEXC_POLL=$CODEXC_POLL \
CODEXC_SESSION=$(printf '%q' "$CODEXC_SESSION") \
CODEX_HOME=$(printf '%q' "$CODEX_HOME_DIR") \
CODEXC_AT=$(printf '%q' "$CODEXC_AT") \
CODEXC_TARGET=$(printf '%q' "$CODEXC_TARGET") \
CODEXC_PROMPT=$(printf '%q' "$CODEXC_PROMPT") \
CODEXC_EXTRA_RE=$(printf '%q' "$CODEXC_EXTRA_RE") \
CODEXC_AUTO_YES=$(printf '%q' "$CODEXC_AUTO_YES") \
CODEXC_LOOP=$(printf '%q' "${CODEXC_LOOP:-}") \
CODEXC_TOOL=$(printf '%q' "$CODEXC_TOOL") \
CLAUDE_CONFIG_DIR=$(printf '%q' "$CLAUDE_DIR")"
for setting in CODEXC_NOTIFY CODEXC_NOTIFY_SECS CODEXC_NOTIFY_GAP CODEXC_LOOP_NOTIFY CODEXC_LOOP_POLL CODEXC_LOOP_STALL CODEXC_TURN_TIMEOUT CODEXC_LOOP_DRY CODEXC_LOOP_IDLE CODEXC_IDLE_PARK CODEXC_LOOP_ROLLOUT CODEXC_GATE_TIMEOUT CODEXC_GATE_RETRIES CODEXC_REVIEW_CMD CODEXC_REVIEW_PASS CODEXC_REVIEW_ROUNDS CODEXC_REVIEW_TIMEOUT CODEXC_BANNER CODEXC_PROMPT_ROTATION CODEXC_REQUIRE_GATE CODEXC_NIGHT_IDLE CODEXC_NIGHT_WINDOW CODEXC_NIGHT_TZ CODEXC_ACTIVE_WINDOW CODEXC_ACTIVE_TZ PI_DIR OPENCODE_DATA_DIR; do
    if declare -p "$setting" >/dev/null 2>&1; then
        inner="$inner $setting=$(printf '%q' "${!setting}")"
    fi
done
[ "$NO_LOOP" != "1" ] || inner="$inner CODEXC_NIGHT_IDLE=0"
inner="$inner OPENCODE_DATA_DIR=$(printf '%q' "$OPENCODE_DIR") $(printf '%q' "$SELF") $codex_args"

if [ -n "$CODEXC_AT" ]; then
    echo "codexc: session '${CODEXC_SESSION}' created; prompt fires at ${CODEXC_AT} (log: ${WATCHLOG})" >&2
fi

if ! tmux new-session -d -s "$CODEXC_SESSION" -c "$PWD" "$inner"; then
    if tmux has-session -t "=$CODEXC_SESSION" 2>/dev/null; then
            existing_path="$(tmux display-message -p -t "=$CODEXC_SESSION:" '#{session_path}' 2>/dev/null)"
            existing_phys="$(cd "$existing_path" 2>/dev/null && pwd -P)"
            if [ "$existing_phys" != "$(pwd -P)" ]; then
            echo "codexc: session name '$CODEXC_SESSION' was claimed by another directory; run codexc again to resolve a unique name" >&2
            exit 1
        fi
    else
        echo "codexc: failed to create tmux session '$CODEXC_SESSION'" >&2
        exit 1
    fi
fi
tmux set-option -t "=$CODEXC_SESSION:" remain-on-exit off >/dev/null 2>&1
exec tmux attach -t "=$CODEXC_SESSION"

